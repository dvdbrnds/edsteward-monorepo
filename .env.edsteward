# EdSteward Integration Configuration
# Update these with your actual EdSteward credentials

# EdSteward Server URL
EDSTEWARD_URL=http://localhost:3000

# Basic Authentication (choose one method)
# Method 1: Username/Password (Basic Auth)
EDSTEWARD_USERNAME=your_username_here
EDSTEWARD_PASSWORD=your_password_here

# Method 2: API Key (Bearer Token) - alternative to username/password
# EDSTEWARD_API_KEY=your_api_key_here

# WebSocket URL for real-time notifications
EDSTEWARD_WS_URL=ws://localhost:3000/ws
