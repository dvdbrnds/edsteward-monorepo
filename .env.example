# Environment Configuration
NODE_ENV=development

# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/edsteward_main"

# Multi-Tenant Database URLs (each tenant gets its own database for complete isolation)
ADMIN_DATABASE_URL="postgresql://user:password@localhost:5432/edsteward_admin"
MORAVIAN_DATABASE_URL="postgresql://user:password@localhost:5432/edsteward_moravian"
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/edsteward_test"

# Session Configuration
SESSION_SECRET="your-super-secret-session-key-change-this-in-production"

# Server Configuration
PORT=3000

# Optional: Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password

# Optional: Twilio Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Optional: OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key

# Optional: Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Frontend URLs
REACT_APP_API_URL=http://localhost:3000
REACT_APP_WS_URL=ws://localhost:3000

# Moravian University SAML/Okta Configuration
MORAVIAN_OKTA_SSO_URL=https://your-okta-domain.okta.com/app/edsteward/exk1234567890/sso/saml
MORAVIAN_OKTA_SLO_URL=https://your-okta-domain.okta.com/app/edsteward/exk1234567890/slo/saml
MORAVIAN_OKTA_ENTITY_ID=http://www.okta.com/exk1234567890
MORAVIAN_OKTA_CERT="-----BEGIN CERTIFICATE-----
MIICmzCCAYMCBgF...
-----END CERTIFICATE-----" 