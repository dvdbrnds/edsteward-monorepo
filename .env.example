# =============================================================================
# EdSteward Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env files with real credentials to git
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Core Configuration
# -----------------------------------------------------------------------------

# Node environment: development | production | staging | test
NODE_ENV=development

# Database connection (PostgreSQL) - REQUIRED
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/edsteward"

# Session secret - REQUIRED (generate a random 64+ character string)
SESSION_SECRET="generate-a-random-64-character-string-here-for-security"

# Server port (default: 3000)
PORT=3000

# -----------------------------------------------------------------------------
# REQUIRED: Institution Configuration  
# -----------------------------------------------------------------------------

# Your institution's name (displayed in UI)
INSTITUTION_NAME="Your University"

# Your institution's domain
INSTITUTION_DOMAIN="youruniversity.edu"

# -----------------------------------------------------------------------------
# OPTIONAL: Multi-Tenant Mode
# -----------------------------------------------------------------------------

# Enable multi-tenant mode (default: false)
MULTI_TENANT=false

# Tenant-specific database URLs (only if MULTI_TENANT=true)
# MORAVIAN_DATABASE_URL="postgresql://..."
# STAGING_DATABASE_URL="postgresql://..."

# -----------------------------------------------------------------------------
# OPTIONAL: Authentication - SAML/SSO
# -----------------------------------------------------------------------------

# Enable SAML authentication
AUTH_SAML_ENABLED=false

# SAML Entity ID (your app's identifier in the IdP)
# AUTH_SAML_ENTITY_ID="https://yourdomain.com"

# SAML SSO URL (from your IdP - Okta, Azure AD, etc.)
# AUTH_SAML_SSO_URL="https://your-idp.com/sso"

# SAML Certificate (paste the IdP's signing certificate, or use file)
# AUTH_SAML_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Base URL for SAML callbacks
# BASE_URL="https://yourdomain.com"

# -----------------------------------------------------------------------------
# OPTIONAL: Authentication - Local
# -----------------------------------------------------------------------------

# Enable username/password authentication (default: true)
AUTH_USERNAME_PASSWORD_ENABLED=true

# Allow self-registration (default: false)
AUTH_ALLOW_SELF_REGISTRATION=false

# -----------------------------------------------------------------------------
# OPTIONAL: Branding
# -----------------------------------------------------------------------------

# Institution logo URL
INSTITUTION_LOGO_URL="/assets/institution-logo.png"

# Institution favicon
INSTITUTION_FAVICON_URL="/favicon.ico"

# Primary brand color (hex)
INSTITUTION_PRIMARY_COLOR="#0066cc"

# Secondary brand color (hex)
INSTITUTION_SECONDARY_COLOR="#336699"

# -----------------------------------------------------------------------------
# OPTIONAL: Email Configuration (for notifications/attestations)
# -----------------------------------------------------------------------------

# SMTP Host
EMAIL_HOST="smtp.gmail.com"

# SMTP Port
EMAIL_PORT=587

# SMTP Username (email address)
EMAIL_USER=""

# SMTP Password or App Password
EMAIL_PASS=""

# From address for outgoing emails
EMAIL_FROM="noreply@yourdomain.com"

# -----------------------------------------------------------------------------
# OPTIONAL: Feature Flags
# -----------------------------------------------------------------------------

# Maximum users allowed
FEATURE_MAX_USERS=1000

# Maximum regulations
FEATURE_MAX_REGULATIONS=10000

# Enable API access
FEATURE_API_ACCESS=true

# Enable custom domain support
FEATURE_CUSTOM_DOMAIN=false

# Enable SSO features
FEATURE_SSO_ENABLED=false

# -----------------------------------------------------------------------------
# OPTIONAL: MFA (Multi-Factor Authentication)
# -----------------------------------------------------------------------------

# Encryption key for MFA secrets (generate a random 32+ char string)
# MFA_ENCRYPTION_KEY="generate-random-32-char-string"

# -----------------------------------------------------------------------------
# OPTIONAL: Contact Information
# -----------------------------------------------------------------------------

# Support email
SUPPORT_EMAIL="support@yourdomain.com"

# Admin email
ADMIN_EMAIL="admin@yourdomain.com"

# Organization URL
ORGANIZATION_URL="https://youruniversity.edu"

# -----------------------------------------------------------------------------
# OPTIONAL: External Services
# -----------------------------------------------------------------------------

# OpenAI API Key (for AI features)
# OPENAI_API_KEY=""

# AWS Configuration (for backups, etc.)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION="us-east-1"

# -----------------------------------------------------------------------------
# DEVELOPMENT ONLY
# -----------------------------------------------------------------------------

# Enable backup scheduler (typically disabled in dev)
ENABLE_BACKUP_SCHEDULER=false

# Docker container detection
DOCKER_CONTAINER=false
