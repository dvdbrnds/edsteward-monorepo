{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🐳 Docker: Start Development",
            "type": "shell",
            "command": "./dev.sh up",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Start EdSteward Docker development environment"
        },
        {
            "label": "🛑 Docker: Stop Development",
            "type": "shell",
            "command": "./dev.sh down",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
