            "command": "echo '❌ ERROR: npm run dev is DISABLED for EdSteward!' && echo '' && echo '🐳 Use Docker development instead:' && echo '   ./dev.sh up' && echo '' && echo 'This prevents deployment issues and ensures consistency.' && exit 1",
