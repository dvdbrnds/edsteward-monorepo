# Development Dockerfile with hot reloading
FROM node:18-alpine AS development

# Install development dependencies including init system
RUN apk add --no-cache \
    git \
    curl \
    bash \
    vim \
    tini

WORKDIR /app

# Copy package files
COPY package.json package-lock.json ./

# Install all dependencies (including dev)
RUN npm ci --legacy-peer-deps

# Copy source code (will be overridden by volume mounts in development)
COPY . .

# Create necessary directories
RUN mkdir -p /app/uploads /app/logs /app/dist

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001 -G nodejs

# Change ownership of app directory
RUN chown -R nextjs:nodejs /app
USER nextjs

# Expose ports
EXPOSE 3000 5173

# Add health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:3000/api/health || exit 1

# Use tini as init system for better signal handling
ENTRYPOINT ["/sbin/tini", "--"]

# Development command (will be overridden by docker-compose)
CMD ["npm", "run", "dev"]

# Production stage (for final build)
FROM development AS production-ready

# Switch back to root for build
USER root

# Build the application
RUN npm run build

# Switch back to nodejs user
USER nextjs

# Set production environment
ENV NODE_ENV=production

# Production command
CMD ["npm", "start"] 