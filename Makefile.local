# EdSteward Local Development Pipeline
# Focused on Docker development with staging verification

.PHONY: help clean check-tools dev dev-logs dev-stop dev-restart dev-shell dev-status staging staging-logs staging-stop staging-restart staging-approve build-for-prod

# Default shell for macOS
SHELL := /bin/zsh

# Configuration
PROJECT_NAME := edsteward
DEV_COMPOSE := docker-compose.dev.yml
STAGING_COMPOSE := docker-compose.local-staging.yml

# Colors for output
RED := \033[0;31m
GREEN := \033[0;32m
YELLOW := \033[1;33m
BLUE := \033[0;34m
NC := \033[0m # No Color

help: ## Show this help message
	@echo "$(BLUE)EdSteward Local Development Pipeline$(NC)"
	@echo "============================================="
	@echo ""
	@echo "$(GREEN)🚀 Development Workflow:$(NC)"
	@echo "  make dev                   # Start development environment with hot reload"
	@echo "  make dev-logs              # View development logs (live)"
	@echo "  make dev-shell             # Open shell in development container"
	@echo "  make dev-restart           # Restart development environment"
	@echo "  make dev-stop              # Stop development environment"
	@echo ""
	@echo "$(YELLOW)🎭 Staging & Testing:$(NC)"
	@echo "  make staging               # Start staging environment for testing"
	@echo "  make staging-logs          # View staging logs"
	@echo "  make staging-approve       # Mark staging as production-ready"
	@echo "  make staging-stop          # Stop staging environment"
	@echo ""
	@echo "$(BLUE)🏗️  Production Prep:$(NC)"
	@echo "  make build-for-prod        # Build production-ready Docker image"
	@echo "  make check-tools           # Verify required tools"
	@echo "  make clean                 # Clean up all containers and images"
	@echo ""
	@echo "$(GREEN)📖 Quick Start:$(NC)"
	@echo "  1. make dev                # Start developing with hot reload"
	@echo "  2. make staging            # Test in staging when ready"
	@echo "  3. make staging-approve    # Mark as production-ready"
	@echo ""

check-tools: ## Verify all required tools are installed
	@echo "$(BLUE)🔧 Checking required tools...$(NC)"
	@command -v docker >/dev/null 2>&1 || { echo "$(RED)❌ Docker is required but not installed$(NC)"; exit 1; }
	@command -v docker-compose >/dev/null 2>&1 || { echo "$(RED)❌ Docker Compose is required but not installed$(NC)"; exit 1; }
	@command -v node >/dev/null 2>&1 || { echo "$(RED)❌ Node.js is required but not installed$(NC)"; exit 1; }
	@command -v npm >/dev/null 2>&1 || { echo "$(RED)❌ npm is required but not installed$(NC)"; exit 1; }
	@echo "$(GREEN)✅ All required tools are installed$(NC)"

clean: ## Clean up containers, images, and networks
	@echo "$(YELLOW)🧹 Cleaning up all environments...$(NC)"
	-docker-compose -f $(DEV_COMPOSE) down -v 2>/dev/null
	-docker-compose -f $(STAGING_COMPOSE) down -v 2>/dev/null
	-docker image prune -f
	-docker volume prune -f
	@echo "$(GREEN)✅ Cleanup completed$(NC)"

# Development Environment
dev: check-tools ## Start development environment with hot reload
	@echo "$(BLUE)🚀 Starting development environment...$(NC)"
	@echo "$(YELLOW)📝 Your source code will be mounted for hot reloading$(NC)"
	@echo ""
	
	@# Stop staging if running to avoid port conflicts
	-docker-compose -f $(STAGING_COMPOSE) down 2>/dev/null
	
	@docker-compose -f $(DEV_COMPOSE) up -d --build
	@echo ""
	@echo "$(GREEN)✅ Development environment ready!$(NC)"
	@echo ""
	@echo "$(BLUE)🌐 Your application is running at:$(NC)"
	@echo "  • Main app: $(YELLOW)http://localhost:3000$(NC)"
	@echo "  • Database: PostgreSQL on localhost:5433"
	@echo "  • Redis: localhost:6380"
	@echo ""
	@echo "$(GREEN)🎉 Start coding! Changes will be reflected immediately.$(NC)"
	@echo ""
	@echo "$(BLUE)💡 While developing:$(NC)"
	@echo "  make dev-logs     # Watch live logs"
	@echo "  make dev-shell    # Open container shell"
	@echo "  make staging      # Test in staging when ready"

dev-logs: ## View development logs (live)
	@echo "$(BLUE)📋 Development logs (Ctrl+C to exit):$(NC)"
	@docker-compose -f $(DEV_COMPOSE) logs -f app-dev

dev-shell: ## Open shell in development container
	@echo "$(BLUE)🐚 Opening shell in development container...$(NC)"
	@docker-compose -f $(DEV_COMPOSE) exec app-dev /bin/bash || \
		echo "$(RED)❌ Development container not running. Start with: make dev$(NC)"

dev-restart: ## Restart development environment
	@echo "$(BLUE)🔄 Restarting development environment...$(NC)"
	@docker-compose -f $(DEV_COMPOSE) restart app-dev
	@echo "$(GREEN)✅ Development environment restarted$(NC)"

dev-stop: ## Stop development environment
	@echo "$(YELLOW)🛑 Stopping development environment...$(NC)"
	@docker-compose -f $(DEV_COMPOSE) down
	@echo "$(GREEN)✅ Development environment stopped$(NC)"

dev-status: ## Check development environment status
	@echo "$(BLUE)📊 Development environment status:$(NC)"
	@docker-compose -f $(DEV_COMPOSE) ps

# Staging Environment
staging: check-tools ## Start staging environment for testing
	@echo "$(BLUE)🎭 Starting staging environment...$(NC)"
	@echo "$(YELLOW)This creates a production-like environment for testing$(NC)"
	@echo ""
	
	@# Stop dev if running to avoid port conflicts
	-docker-compose -f $(DEV_COMPOSE) down 2>/dev/null
	
	@echo "$(BLUE)🏗️  Building production-like image...$(NC)"
	@docker-compose -f $(STAGING_COMPOSE) up -d --build
	
	@echo "$(BLUE)⏳ Waiting for staging environment...$(NC)"
	@sleep 15
	@./scripts/wait-for-health.sh http://localhost:3000/health 120 || { \
		echo "$(RED)❌ Staging environment failed to start$(NC)"; \
		make staging-logs; \
		exit 1; \
	}
	
	@echo ""
	@echo "$(GREEN)✅ Staging environment ready for testing!$(NC)"
	@echo ""
	@echo "$(BLUE)🌐 Test your application at: $(YELLOW)http://localhost:3000$(NC)"
	@echo ""
	@echo "$(YELLOW)📋 Manual testing checklist:$(NC)"
	@echo "  ✓ Open http://localhost:3000 and test UI"
	@echo "  ✓ Test all application features"
	@echo "  ✓ Check browser console for errors"
	@echo "  ✓ Verify performance is acceptable"
	@echo "  ✓ Test authentication if applicable"
	@echo ""
	@echo "$(BLUE)💡 When satisfied with testing:$(NC)"
	@echo "  make staging-approve   # Mark as production-ready"

staging-logs: ## View staging logs
	@echo "$(BLUE)📋 Staging environment logs:$(NC)"
	@docker-compose -f $(STAGING_COMPOSE) logs -f app

staging-stop: ## Stop staging environment
	@echo "$(YELLOW)🛑 Stopping staging environment...$(NC)"
	@docker-compose -f $(STAGING_COMPOSE) down
	@echo "$(GREEN)✅ Staging environment stopped$(NC)"

staging-restart: ## Restart staging environment
	@echo "$(BLUE)🔄 Restarting staging environment...$(NC)"
	@$(MAKE) staging-stop
	@$(MAKE) staging

staging-approve: ## Mark current version as production-ready
	@echo "$(YELLOW)🎯 PRODUCTION READINESS APPROVAL$(NC)"
	@echo "================================="
	@echo ""
	@echo "$(BLUE)You have tested the staging environment.$(NC)"
	@echo "$(BLUE)Mark this version as production-ready? (y/N)$(NC)"
	@echo ""
	@read -r APPROVE; \
	if [ "$$APPROVE" != "y" ] && [ "$$APPROVE" != "Y" ]; then \
		echo "$(YELLOW)🛑 Production readiness not approved$(NC)"; \
		echo "$(BLUE)💡 Continue testing or return to development$(NC)"; \
		exit 1; \
	fi
	
	@echo "$(GREEN)✅ Version marked as production-ready!$(NC)"
	@echo ""
	@echo "$(BLUE)📝 Creating production-ready artifact...$(NC)"
	@$(MAKE) build-for-prod
	@echo ""
	@echo "$(GREEN)🎉 This version is ready for production deployment!$(NC)"
	@echo "$(BLUE)💡 Production image tagged and ready for AWS deployment$(NC)"

# Production Preparation
build-for-prod: ## Build production-ready Docker image
	@echo "$(BLUE)🏗️  Building production-ready Docker image...$(NC)"
	@PROD_TAG=$$(date +%Y%m%d-%H%M%S)-prod; \
	docker build -t $(PROJECT_NAME):$$PROD_TAG -t $(PROJECT_NAME):production-ready .; \
	echo "$$PROD_TAG" > .production-ready-tag; \
	echo "$(GREEN)✅ Production image built: $(PROJECT_NAME):$$PROD_TAG$(NC)"; \
	echo "📋 Tag saved to .production-ready-tag"

# Quick workflow commands
dev-to-staging: dev-stop staging ## Stop dev and start staging
ready-for-prod: staging-approve ## Quick alias for staging approval

# Status commands
status: ## Show status of all environments
	@echo "$(BLUE)📊 Environment Status$(NC)"
	@echo "====================="
	@echo ""
	@echo "$(YELLOW)Development:$(NC)"
	@docker-compose -f $(DEV_COMPOSE) ps 2>/dev/null || echo "  Not running"
	@echo ""
	@echo "$(YELLOW)Staging:$(NC)"
	@docker-compose -f $(STAGING_COMPOSE) ps 2>/dev/null || echo "  Not running" 