FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY server/package*.json ./server/

# Install dependencies
RUN npm install
RUN cd server && npm install

# Copy server source code
COPY server ./server

# Create logs directory
RUN mkdir -p logs

# Expose port
EXPOSE 4000

# Set environment
ENV NODE_ENV=development
ENV ADMIN_PORT=4000

# Start the admin backend server
CMD ["npm", "run", "start:admin"] 