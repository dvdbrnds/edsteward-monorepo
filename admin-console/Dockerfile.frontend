FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY src ./src
COPY public ./public
COPY index.html ./
COPY vite.config.ts ./
COPY tsconfig.json ./
COPY tsconfig.node.json ./
COPY tailwind.config.js ./
COPY postcss.config.js ./

# Expose port
EXPOSE 3001

# Set environment
ENV VITE_ADMIN_API_URL=http://localhost:4000

# Start the development server
CMD ["npm", "run", "dev"] 