# Environment
NODE_ENV=production

# Database configuration (EdSteward admin console metadata)
DATABASE_URL=postgresql://neondb_owner:npg_foSr6ixkzw7W@ep-weathered-term-a5rmi9cx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Session configuration
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Development token for testing
ADMIN_TOKEN=your-development-admin-token

# Server configuration
PORT=4000
HOST=0.0.0.0

# Deployment configuration
DEPLOYMENT_LOGS_PATH=../deployments
CUSTOMER_CONFIGS_PATH=../customer-configs

# AWS CLI configuration
AWS_PROFILE=default
AWS_REGION=us-east-1

# WebSocket configuration for real-time deployment monitoring
WS_PORT=4000

# Features
ENABLE_DEPLOYMENT_WIZARD=true
ENABLE_WEBSOCKET_MONITORING=true
ENABLE_REAL_TIME_LOGS=true

# Security
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
TRUST_PROXY=false