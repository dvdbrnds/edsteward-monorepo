{
  "family": "edsteward-beta",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::259661441422:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "edsteward-beta-test-company",
      "image": "259661441422.dkr.ecr.us-east-1.amazonaws.com/edsteward-multi-tenant:truly-isolated",
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "3000"
        },
        {
          "name": "DATABASE_URL",
          "value": "postgresql://neondb_owner:npg_fHNv4k1VKwWd@ep-cool-grass-ae3mjdz3-pooler.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
        },
        {
          "name": "SESSION_SECRET",
          "value": "beta-session-secret-change-this-in-production"
        },
        {
          "name": "MULTI_TENANT",
          "value": "false"
        },
        {
          "name": "INSTITUTION_NAME",
          "value": "Beta Test Company"
        },
        {
          "name": "INSTITUTION_TITLE",
          "value": "Beta Test Compliance Portal"
        },
        {
          "name": "INSTITUTION_LOGO_URL",
          "value": "/assets/beta-logo.svg"
        },
        {
          "name": "INSTITUTION_FAVICON_URL",
          "value": "/assets/beta-favicon.ico"
        },
        {
          "name": "INSTITUTION_PRIMARY_COLOR",
          "value": "#e11d48"
        },
        {
          "name": "INSTITUTION_SECONDARY_COLOR",
          "value": "#be185d"
        },
        {
          "name": "INSTITUTION_ACCENT_COLOR",
          "value": "#f97316"
        },
        {
          "name": "LOGIN_SCREEN_BACKGROUND_COLOR",
          "value": "#fef2f2"
        },
        {
          "name": "LOGIN_SCREEN_ACCENT_COLOR",
          "value": "#e11d48"
        },
        {
          "name": "LOGIN_SCREEN_TEXT_COLOR",
          "value": "#1f2937"
        },
        {
          "name": "LOGIN_SCREEN_HERO_COLOR",
          "value": "#be185d"
        },
        {
          "name": "SUPPORT_EMAIL",
          "value": "support@betatest.com"
        },
        {
          "name": "ADMIN_EMAIL",
          "value": "admin@betatest.com"
        },
        {
          "name": "ORGANIZATION_URL",
          "value": "https://betatest.com"
        },
        {
          "name": "AUTH_SAML_ENABLED",
          "value": "false"
        },
        {
          "name": "AUTH_SAML_ENTITY_ID",
          "value": "urn:edsteward:sp:beta"
        },
        {
          "name": "AUTH_SAML_SSO_URL",
          "value": "https://sso.betatest.com/saml"
        },
        {
          "name": "AUTH_USERNAME_PASSWORD_ENABLED",
          "value": "true"
        },
        {
          "name": "AUTH_ALLOW_SELF_REGISTRATION",
          "value": "true"
        },
        {
          "name": "FEATURE_MAX_USERS",
          "value": "100"
        },
        {
          "name": "FEATURE_MAX_REGULATIONS",
          "value": "1000"
        },
        {
          "name": "FEATURE_API_ACCESS",
          "value": "true"
        },
        {
          "name": "FEATURE_CUSTOM_DOMAIN",
          "value": "true"
        },
        {
          "name": "FEATURE_SSO_ENABLED",
          "value": "false"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/aws/ecs/edsteward-beta",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "edsteward-beta-test-company"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:3000/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "essential": true
    }
  ]
}
