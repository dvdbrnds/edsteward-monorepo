#!/bin/sh
# Context7 Best Practice: Comprehensive pre-commit hook for code quality

echo "🔍 Running pre-commit hooks..."

# Context7 Best Practice: Run lint-staged for file-specific checks
echo "📝 Checking staged files with lint-staged..."
npx lint-staged
if [ $? -ne 0 ]; then
  echo "❌ lint-staged failed. Please fix the issues and try again."
  exit 1
fi

# Context7 Best Practice: Run TypeScript type checking on entire project
