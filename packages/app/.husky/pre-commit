# Context7 Best Practice: Check for common security patterns
echo "🔒 Checking for potential security issues..."
if grep -r --include="*.ts" --include="*.tsx" --include="*.js" --include="*.jsx" -E "(console\.log|debugger|\.only\(|\.skip\()" client/ server/ shared/ 2>/dev/null; then
  echo "⚠️ Found potential debugging code or focused tests."
  echo "  Consider removing console.log, debugger, .only(), or .skip() before committing."
fi

# Context7 Best Practice: Check for TODO/FIXME comments that might need attention
echo "📋 Checking for TODO/FIXME comments..."
TODO_COUNT=$(grep -r --include="*.ts" --include="*.tsx" --include="*.js" --include="*.jsx" -E "(TODO|FIXME|HACK)" client/ server/ shared/ 2>/dev/null | wc -l)
if [ "$TODO_COUNT" -gt 0 ]; then
  echo "📝 Found $TODO_COUNT TODO/FIXME comments in codebase."
fi

# Context7 Best Practice: Verify no sensitive information is being committed
echo "🔐 Checking for potential sensitive information..."
if grep -r --include="*.ts" --include="*.tsx" --include="*.js" --include="*.jsx" --include="*.json" -E "(password|secret|key|token|api_key)" --exclude-dir=node_modules . 2>/dev/null | grep -v -E "(Password|SecretKey|TokenType|ApiKey)" | head -5; then
  echo "⚠️ Found potential sensitive information. Please review before committing."
fi

echo "✅ Pre-commit checks completed successfully!"
echo "🚀 Proceeding with commit..."
