{
    "name": "edsteward-admin-console",
    "version": "2.0.0",
    "description": "EdSteward Admin Console - Comprehensive SaaS Administration Platform",
    "type": "module",
    "scripts": {
        "dev": "vite --port 3001 --host 0.0.0.0",
        "dev:full": "npm run dev:admin & npm run dev",
        "build": "tsc && vite build",
        "preview": "vite preview --port 3001",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "test": "vitest",
        "start:admin": "cd server && npm run start",
        "dev:admin": "cd server && npm install && npm run build && node dist/index.js",
        "docker:dev": "docker-compose up -d",
        "docker:stop": "docker-compose down",
        "docker:logs": "docker-compose logs -f"
    },
    "dependencies": {
        "@hookform/resolvers": "^2.9.11",
        "@radix-ui/react-label": "^2.1.7",
        "@radix-ui/react-progress": "^1.1.7",
        "@radix-ui/react-select": "^2.2.5",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-tabs": "^1.1.12",
        "@tanstack/react-query": "^4.28.0",
        "@tanstack/react-table": "^8.7.9",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^2.29.3",
        "framer-motion": "^10.6.0",
        "html2canvas": "^1.4.1",
        "jspdf": "^2.5.1",
        "lucide-react": "^0.323.0",
        "react": "^18.2.0",
        "react-beautiful-dnd": "^13.1.1",
        "react-dom": "^18.2.0",
        "react-dropzone": "^14.2.3",
        "react-error-boundary": "^4.0.10",
        "react-helmet-async": "^1.3.0",
        "react-hook-form": "^7.43.1",
        "react-hotkeys-hook": "^4.3.8",
        "react-query": "^3.39.3",
        "react-router-dom": "^6.8.1",
        "react-select": "^5.7.0",
        "react-table": "^7.8.0",
        "react-virtualized": "^9.22.5",
        "react-window": "^1.8.8",
        "recharts": "^2.5.0",
        "socket.io-client": "^4.6.1",
        "tailwind-merge": "^3.3.1",
        "xlsx": "^0.18.5",
        "zod": "^3.20.6"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^5.16.5",
        "@testing-library/react": "^14.0.0",
        "@testing-library/user-event": "^14.4.3",
        "@types/react": "^18.0.28",
        "@types/react-beautiful-dnd": "^13.1.4",
        "@types/react-dom": "^18.0.11",
        "@types/react-table": "^7.7.14",
        "@types/react-virtualized": "^9.21.21",
        "@types/react-window": "^1.8.5",
        "@typescript-eslint/eslint-plugin": "^5.54.0",
        "@typescript-eslint/parser": "^5.54.0",
        "@vitejs/plugin-react": "^3.1.0",
        "autoprefixer": "^10.4.14",
        "eslint": "^8.35.0",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-react-refresh": "^0.3.4",
        "postcss": "^8.4.21",
        "tailwindcss": "^3.2.7",
        "typescript": "^4.9.3",
        "vite": "^4.2.0",
        "vitest": "^0.29.2"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
