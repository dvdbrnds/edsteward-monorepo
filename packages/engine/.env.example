# Server Configuration
PORT=3000
NODE_ENV=development
SERVICE_NAME=regulation-compliance-service

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=regulations
POSTGRES_USER=app_user
POSTGRES_PASSWORD=

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Kafka Configuration
KAFKA_BROKER=localhost:29092
ENABLE_CDC=true

# AWS Configuration (optional)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Observability (optional)
OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics

# Rate Limiting
STANDARD_RATE_LIMIT=100
BULK_RATE_LIMIT=10

# Default Tenant
DEFAULT_TENANT_ID=default

# EdSteward App Integration (must match app .env)
EDSTEWARD_URL=http://localhost:3000
EDSTEWARD_WS_URL=
EDSTEWARD_USERNAME=
EDSTEWARD_PASSWORD=
EDSTEWARD_HEALTH_ENDPOINT=
EDSTEWARD_STATUS_ENDPOINT=
MCP_API_KEY=

# AI — Single Anthropic key for all engine AI features
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
LLM_MODEL=claude-sonnet-4-20250514
LLM_DEFAULT_MODEL=claude-sonnet-4-20250514
MAX_TOKENS=4096
LLM_TEMPERATURE=0.1

# Government API Keys (free registration — used for cross-referencing)
# CourtListener: https://www.courtlistener.com/api/
COURTLISTENER_API_KEY=
# Congress.gov: https://api.congress.gov/sign-up/
CONGRESS_API_KEY=
# Regulations.gov: https://api.data.gov/signup/
REGULATIONS_GOV_API_KEY=
# GovInfo (GPO): https://api.govinfo.gov/docs/ (uses api.data.gov keys)
GOVINFO_API_KEY=
# Open States: https://openstates.org/accounts/signup/
OPEN_STATES_API_KEY=
