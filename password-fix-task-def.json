{
    "family": "edsteward-password-fix",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512",
    "executionRoleArn": "arn:aws:iam::259661441422:role/ecsTaskExecutionRole",
    "containerDefinitions": [
        {
            "name": "password-fix",
            "image": "259661441422.dkr.ecr.us-east-1.amazonaws.com/edsteward-multi-tenant:scrypt-production",
            "essential": true,
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/edsteward-password-fix",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "ecs"
                }
            },
            "environment": [
                {
                    "name": "NODE_ENV",
                    "value": "production"
                },
                {
                    "name": "DATABASE_URL",
                    "value": "postgres://neondb_owner:npg_foSr6ixkzw7W@ep-calm-shadow-a5fzfq7w.us-east-1.aws.neon.tech/neondb?sslmode=require"
                },
                {
                    "name": "DB_HOST",
                    "value": "ep-calm-shadow-a5fzfq7w.us-east-1.aws.neon.tech"
                },
                {
                    "name": "DB_PORT",
                    "value": "5432"
                },
                {
                    "name": "DB_NAME",
                    "value": "neondb"
                },
                {
                    "name": "DB_USER",
                    "value": "neondb_owner"
                },
                {
                    "name": "DB_PASSWORD",
                    "value": "npg_foSr6ixkzw7W"
                },
                {
                    "name": "DB_SSL_MODE",
                    "value": "require"
                },
                {
                    "name": "PORT",
                    "value": "3000"
                }
            ],
            "command": [
                "npx",
                "tsx",
                "scripts/fix-user-password.ts"
            ]
        }
    ]
}