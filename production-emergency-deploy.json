{
  "family": "edsteward-emergency-production",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::259661441422:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::259661441422:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "edsteward-app",
      "image": "259661441422.dkr.ecr.us-east-1.amazonaws.com/edsteward-multi-tenant:latest",
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "MULTI_TENANT",
          "value": "true"
        },
        {
          "name": "PORT",
          "value": "3000"
        },
        {
          "name": "DATABASE_URL",
          "value": "postgresql://neondb_owner:npg_foSr6ixkzw7W@ep-weathered-term-a5rmi9cx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
        },
        {
          "name": "SESSION_SECRET",
          "value": "edsteward-production-session-secret-2025-v1.21-fixed"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/edsteward-simple",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "essential": true
    }
  ]
} 