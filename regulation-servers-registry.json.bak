  "Accou-1754-XXXX": {
    "id": "Accou-1754-XXXX",
    "name": "Sarbanes Oxley Act of 2002 (SOX)",
    "category": "Accounting",
    "description": "Designed to protect investors by improving the accuracy and reliability of corporate disclosures made pursuant to the securities laws.\n\n \tDoes not apply to public entities but may represent best practices.\n\n \t18 U.S. Code § 1519 makes destruction, alteration, or falsification of records in federal investigations, bankruptcy, or any matter within the jurisdiction of a federal department or agency a crime punishable by fines and up to 20 years imprisonment, and applies to all individuals, not just publicly traded corporations.\n\n \tBars independent auditors from providing certain non-audit services to the client institution.",
    "version": "1.0.0",
    "statute": "1754",
    "statuteReference": "Public Law No. 107-204",
    "regulation": "",
    "regulationReference": "",
    "deadline": "Not Applicable",
    "deadlineType": "14-No Deadline",
    "validationFrequency": "asNeeded",
    "server": {
      "port": 3217,
      "running": true,
      "lastStarted": "2025-04-24T22:00:45.695Z",
      "url": "http://localhost:3217/mcp"
    }
  },
  "Accou-1588-XXXX": {
    "id": "Accou-1588-XXXX",
    "name": "Sherman Antitrust Act",
    "category": "Accounting",
    "description": "Prohibits “every contract, combination…, or conspiracy, in restraining of trade or commerce among the several States, or with foreign nations.”\n\n \tThis law has been applied to colleges and universities in a number of instances regarding purchases.\n\n \tThe Department of Justice interpreted this law to mean that financial aid awards must be established independently and not in concert with other institutions.\n\n \tMay also apply to establishing prices for items in a bookstore based on collaboration with a wholesaler or another retailer.\n\n \tSection 568 - known as the antitrust exemption - allows colleges and universities to collaborate on a common formula for determining a student's financial need.",
    "version": "1.0.0",
    "statute": "1588",
    "statuteReference": "15 U.S.C. §§ 1-7",
    "regulation": "",
    "regulationReference": "",
    "deadline": "Not Applicable",
    "deadlineType": "14-No Deadline",
    "validationFrequency": "asNeeded",
    "server": {
      "port": 3218,
      "running": true,
      "lastStarted": "2025-04-24T22:00:45.771Z",
      "url": "http://localhost:3218/mcp"
    }
  },
  "Accou-1708-XXXX": {
    "id": "Accou-1708-XXXX",
    "name": "Social Security Act",
    "category": "Accounting",
    "description": "An employer must pay social security taxes on employees but an exemption exists for most students also working for the University, for clergy whose services are performed in the exercise of their ministry, and for professional employees as defined in 26 CFR § 31.3121(b)(10)-2.\n\n \tTo avoid penalty for reporting incorrect SSN on W-2 forms, transmit data file electronically to the Social Security Administration (SSA). Report all employees hired in the specific quarter listing name (as it appears in HR System), SSN, sex, and date of birth. After information is queried against SSA's database, mismatches are sent back for resolution.",
    "version": "1.0.0",
    "statute": "1708",
    "statuteReference": "42 U.S.C. §§ 301-1397mm",
    "regulation": "20 C.F.R. § 404.1028",
    "regulationReference": "20 C.F.R. § 404.1028, 26 CFR § 31.3121(b)(10)-2",
    "deadline": "Not Applicable",
