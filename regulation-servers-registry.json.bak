      "lastStarted": "2025-04-24T22:00:46.373Z",
      "url": "http://localhost:3243/mcp"
    }
  },
  "Contr-32453246-XXXX": {
    "id": "Contr-32453246-XXXX",
    "name": "Health Insurance Portability and Accountability Act of 1996 (HIPAA)",
    "category": "Contracts & Procurement",
    "description": "Business Associate contracts are required if a vendor will provide a service for or on behalf of the institution using the institution’s personal health information.",
