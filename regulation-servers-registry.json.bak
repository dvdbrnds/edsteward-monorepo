  "Discr-1685-XXXX": {
    "id": "Discr-1685-XXXX",
    "name": "Equal Employment of Veterans",
    "category": "Discrimination",
    "description": "For federal subcontracts of $100,000 or more the University shall include in each of its subcontracts a clause that the subcontractor will not discriminate against any employee or applicant for employment because he or she is a special disabled veteran, veteran of the Vietnam era, recently separated veteran, or other protected veteran in regard to any position for which the employee or applicant for employment is qualified.\n\n \tThe university must agree to take affirmative action to employ and advance qualified individuals without discrimination based on such status.",
    "version": "1.0.0",
