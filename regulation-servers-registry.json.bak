    }
  },
  "Retir-1660-XXXX": {
    "id": "Retir-1660-XXXX",
    "name": "Employee Retirement Income Security Act of 1974 (ERISA)",
    "category": "Retirement",
    "description": "Sets minimum standards for participation, vesting, benefit accrual and funding pension plans.\n\n \tRequires employers to regularly provide participants with information about the plan including information about plan features and funding.\n\n \tRequires accountability of plan fiduciaries and gives participants the right to sue for benefits and breaches of fiduciary duty.",
    "version": "1.0.0",
    "statute": "1660",
    "statuteReference": "29 U.S.C. Chapter 18",
    "regulation": "29 C.F.R. § 2560",
    "regulationReference": "29 C.F.R. § 2560",
    "deadline": "",
    "deadlineType": "13-Multiple Deadlines",
    "validationFrequency": "quarterly",
    "server": {
      "port": 3412,
      "running": true,
      "lastStarted": "2025-04-24T22:00:50.647Z",
      "url": "http://localhost:3412/mcp"
    }
  },
  "Retir-1649-XXXX": {
    "id": "Retir-1649-XXXX",
    "name": "Nonqualified Deferred Inclusion",
    "category": "Retirement",
    "description": "If at any time during a taxable year a nonqualified deferred compensation plan (I) fails to meet the distribution, acceleration, and election requirements of 26 U.S.C. § 409A(a) paragraphs (2), (3), and (4), or (II) is not operated in accordance with such requirements, all compensation deferred under the plan for the taxable year and all preceding tax able years shall be includible in gross income for the taxable year to the extent not subject to a substantial risk of forfeiture and not previously included in gross income.",
    "version": "1.0.0",
    "statute": "1649",
    "statuteReference": "26 U.S.C. § 409A",
    "regulation": "26 C.F.R. §§ 1.409A-0 et seq.",
    "regulationReference": "26 C.F.R. §§ 1.409A-0 et seq.",
