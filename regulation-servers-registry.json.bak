  "Diver-1686-XXXX": {
    "id": "Diver-1686-XXXX",
    "name": "Uniformed Services Employment and Reemployment Rights Act (USERRA)",
    "category": "Diversity/Affirmative Action",
    "description": "Seeks to ensure that members of the uniformed services are entitled to return to their civilian employment upon completion of their service.\n\n \tQualified employees must be reinstated with the seniority, status, and rate of pay they would have obtained had they remained continuously employed by their civilian employer.\n\n \tThe law also protects individuals from discrimination in hiring, promotion, and retention on the basis of present and future membership in the armed services.",
    "version": "1.0.0",
    "statute": "1686",
    "statuteReference": "38 U.S.C. §§ 4301-4335",
    "regulation": "5 C.F.R. § 353",
