  "Tax-1654-XXXX": {
    "id": "Tax-1654-XXXX",
    "name": "Public Disclosure of Material",
    "category": "Tax",
    "description": "The documents that must be made available to the public are: copies of the application for tax exemption (for those organizations which filed before July 15, 1987, this requirement only applies if the organization has a copy of the application on July 15, 1987); and copies of the organization's three most recent annual information returns.\n\n \tEach annual information return must be made available for a period of three years beginning on the date the return is required to be filed, or on the date it is actually filed, whichever is later.\n\n \tGenerally, the annual return information includes Forms 990, 990-EZ, 990-BL, and Form 1065, as well as all schedules and attachments filed with the IRS.\n\n \tThe tax-exempt organization does not have to identify the names and addresses of the contributors to the organization.\n\n \tFor those tax returns filed after August 17, 2006, Form 990-T must also be made available.",
    "version": "1.0.0",
    "statute": "1654",
    "statuteReference": "26 U.S.C. § 6104(d)",
    "regulation": "26 C.F.R. § 301.6104(a)-1",
    "regulationReference": "26 C.F.R. § 301.6104(a)-1",
    "deadline": "Not Applicable",
    "deadlineType": "14-No Deadline",
    "validationFrequency": "asNeeded",
    "server": {
      "port": 3427,
      "running": true,
      "lastStarted": "2025-04-24T22:00:51.030Z",
      "url": "http://localhost:3427/mcp"
    }
  },
  "Tax-1647-XXXX": {
    "id": "Tax-1647-XXXX",
    "name": "Qualified Pensions",
    "category": "Tax",
    "description": "A trust created or organized in the United States and forming part of a stock bonus, pension, or profit-sharing plan of an employer for the exclusive benefit of his employees or their beneficiaries shall constitute a qualified trust.",
    "version": "1.0.0",
    "statute": "1647",
