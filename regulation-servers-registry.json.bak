  "Expor-1728-XXXX": {
    "id": "Expor-1728-XXXX",
    "name": "International Emergency Economic Powers Act",
    "category": "Export Controls",
    "description": "Authorizes the President to declare the existence of an \"unusual and extraordinary threat to the national security, foreign policy, or economy of the United States\" that originates \"in whole or substantial part outside the United States.\" It further authorizes the President, after such a declaration, to block transactions and freeze assets to deal with the threat.\n\n \tIn the event of an actual attack on the United States, the President can also confiscate property connected with a country, group, or person that aided in the attack.",
    "version": "1.0.0",
    "statute": "1728",
    "statuteReference": "50 U.S.C. §§ 1701-1707",
