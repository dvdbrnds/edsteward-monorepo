  "Diver-1662-XXXX": {
    "id": "Diver-1662-XXXX",
    "name": "Equal Pay Act of 1963",
    "category": "Diversity/Affirmative Action",
    "description": "Prohibits sex-based wage discrimination between men and women in the same establishment who perform jobs that require substantially equal skill, effort and responsibility under similar working conditions.",
