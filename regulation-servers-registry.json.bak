    }
  },
  "Tax-1658-XXXX": {
    "id": "Tax-1658-XXXX",
    "name": "Qualified Tuition and Student Loan Interest Reporting",
    "category": "Tax",
    "description": "Institutions must report (1) qualified tuition and related expenses and (2) student loan interest to the IRS.\n\n \tInstitutions must also provide payors with a statement that includes the tax information furnished to the IRS.",
    "version": "1.0.0",
