  "Disab-1701-XXXX": {
    "id": "Disab-1701-XXXX",
    "name": "Americans with Disabilities Act of 1990",
    "category": "Disabilities",
    "description": "Provides broad nondiscrimination protection for individuals with disabilities in employment, public services, and public accommodations, including colleges and universities.\n\n \tThe university must make reasonable accommodations for employees and students with disabilities.\n\n \tEnforced by multiple federal agencies, including the Department of Justice, Department of Labor, and the EEOC.",
