  "Diver-1701-XXXX": {
    "id": "Diver-1701-XXXX",
    "name": "Americans with Disabilities Act of 1990",
    "category": "Diversity/Affirmative Action",
    "description": "Provides broad nondiscrimination protection in employment, public services, and public accommodations including colleges and universities for individuals with disabilities.\n\n \tEnforced by multiple federal agencies, including the Department of Justice, Department of Labor, and the EEOC.",
    "version": "1.0.0",
