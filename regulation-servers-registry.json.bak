  "Wages-1709-XXXX": {
    "id": "Wages-1709-XXXX",
    "name": "Federal Insurance Contributions Act (FICA)",
    "category": "Wages",
    "description": "Provides that service performed in the employ of a school, college or university by a student who is enrolled and regularly attending classes at such school, college, or university is exempt from the FICA tax.\n\n \tAn employee who is in employment for wages which are subject to taxes under the Federal Insurance Contributions Act (FICA) or which are subject to the withholding of income tax from wages must apply for a social security number by filing SSA Form SS-5.\n\n \tAn employer must pay social security taxes on employees, but an exemption exists for most students who are also working for the university and for clergy whose services are performed in the exercise of their ministry.",
    "version": "1.0.0",
    "statute": "1709",
    "statuteReference": "42 U.S.C. §§ 401-434",
    "regulation": "26 C.F.R. § 31",
    "regulationReference": "26 C.F.R. § 31",
