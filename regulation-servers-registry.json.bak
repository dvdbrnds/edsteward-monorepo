  "Intel-1646-XXXX": {
    "id": "Intel-1646-XXXX",
    "name": "American Jobs Creation Act of 2004",
    "category": "Intellectual Property and Technology Transfer",
    "description": "For contributions of patents and certain other intellectual property made to a 501(c)(3) after June 3, 2004 the taxpayer's initial contribution deduction is limited to the lesser of the donor's basis in the contributed property or the fair market value of the property.",
