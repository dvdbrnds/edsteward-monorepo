      "url": "http://localhost:3384/mcp"
    }
  },
  "Priva-1701-XXXX": {
    "id": "Priva-1701-XXXX",
    "name": "Americans with Disabilities Act of 1990",
    "category": "Privacy & Information Security",
    "description": "The ADA contains strict confidentiality requirements for medical information related to employee's disabilities.\n\n \tEnforced by multiple federal agencies, including the Department of Justice, Department of Labor, and the EEOC.",
