      "running": true,
      "lastStarted": "2025-04-24T22:00:45.546Z",
      "url": "http://localhost:3211/mcp"
    }
  },
  "Accou-1655-XXXX": {
    "id": "Accou-1655-XXXX",
    "name": "Federal Insurance Contributions Act (FICA)",
    "category": "Accounting",
    "description": "FICA defines which employers and employees are subject to taxation and levies the tax.\n\n \tProvides that service performed in the employ of a school, college, or university by a student who is enrolled and regularly attending classes at such school, college, or university is exempt from the FICA tax.\n\n \tAn employer must pay social security taxes on employees but an exemption exists for most students also working for the university and for clergy whose services are performed in the exercise of their ministry.",
    "version": "1.0.0",
    "statute": "1655",
    "statuteReference": "26 U.S.C. §§ 3101-3128",
    "regulation": "26 C.F.R. § 31 ",
    "regulationReference": "26 C.F.R. § 31 , 26 C.F.R. § 31.3121, 26 C.F.R. § 31.3306",
    "deadline": "Not Applicable",
