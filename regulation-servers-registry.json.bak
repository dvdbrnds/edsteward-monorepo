      "url": "http://localhost:3355/mcp"
    }
  },
  "Grant-1772-XXXX": {
    "id": "Grant-1772-XXXX",
    "name": "Fraud Enforcement and Recovery Act of 2009 (FERA)",
    "category": "Grants Management",
    "description": "The Act clarifies that the False Claims Act was intended to cover to any false or fraudulent claim for government money or property, regardless of whether the claim is presented to a government official or employee, whether the government has physical custody of the money, or whether the defendant specifically intended to defraud the government.\n\n \tFERA also expands the False Claims Act provisions to sub-recipients of federal funds.",
    "version": "1.0.0",
    "statute": "1772",
    "statuteReference": "Public Law No. 111-21",
