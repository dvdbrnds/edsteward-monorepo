  "Finan-1629-XXXX": {
    "id": "Finan-1629-XXXX",
    "name": "Student Loan Default Prevention Initiative Act of 1990",
    "category": "Financial Aid",
    "description": "Renders institutions with high default rates on student loans ineligible to participate in certain student loan programs.",
    "version": "1.0.0",
