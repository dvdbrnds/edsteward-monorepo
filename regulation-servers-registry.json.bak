      "url": "http://localhost:3395/mcp"
    }
  },
  "Progr-1628-XXXX": {
    "id": "Progr-1628-XXXX",
    "name": "Higher Education Act: State Authorization",
    "category": "Program Integrity Rules",
    "description": "In order for its students to be eligible for Title IV student financial assistance, an institution must be able to demonstrate to ED that it meets the legal authorization standards of every state in which it operates.\n\n \tAn institution offering distance education or correspondence courses must be authorized by each state in which the institution enrolls students, if such authorization is required by the state, in order for these programs to be Title IV eligible. Alternatively, an institution may be authorized through state authorization reciprocity agreements. Institutions must also (1) document the state process for resolving complaints from students enrolled in distance education or correspondence courses and (2) provide public and individualized disclosures to enrolled and prospective students regarding its programs offered solely through distance education or correspondence courses. (effective July 1, 2018)\n\n \tAn institution must make available, upon request, to any enrolled or prospective student a copy of the documents describing the institution's accreditation and its state, federal or tribal approval or licensing. In addition, the institution must provide students and prospective students with contact information for filing complaints with the institution's accreditor and with its state approval agency and any other relevant state official or agency.",
    "version": "1.0.0",
    "statute": "1628",
    "statuteReference": "20 U.S.C. §§ 1001, 1002",
    "regulation": "34 C.F.R. § 600.9",
    "regulationReference": "34 C.F.R. § 600.9",
    "deadline": "Not Applicable",
    "deadlineType": "14-No Deadline",
    "validationFrequency": "asNeeded",
    "server": {
      "port": 3396,
      "running": true,
      "lastStarted": "2025-04-24T22:00:50.265Z",
      "url": "http://localhost:3396/mcp"
    }
  },
  "Progr-1619-XXXX": {
    "id": "Progr-1619-XXXX",
    "name": "Higher Education Act: Misrepresentation",
    "category": "Program Integrity Rules",
    "description": "Makes the institution responsible for substantial misrepresentations made by the institution itself, a representative of the institution, or any person or entity with whom the institution has an agreement to provide educational programs, marketing, advertising, and recruiting or admissions services.\n\n \tBroadens the definitions of misrepresentations of the nature of an institution's educational program, financial charges, or employability of its graduates.\n\n \tExpands the sanctions that ED may impose for substantial misrepresentations.",
    "version": "1.0.0",
    "statute": "1619",
    "statuteReference": "20 U.S.C. § 1094",
    "regulation": "34 C.F.R. § 668",
    "regulationReference": "34 C.F.R. § 668",
