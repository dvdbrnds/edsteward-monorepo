  "Emplo-1776-XXXX": {
    "id": "Emplo-1776-XXXX",
    "name": "Consolidated Omnibus Budget Reconciliation Act (COBRA)",
    "category": "Employee Benefits",
    "description": "Enables employees and their families to continue health care coverage under an employer's group health plan even after they experience an event that would otherwise end their coverage (e.g. layoff, termination, decrease in hours, divorce, etc.).",
