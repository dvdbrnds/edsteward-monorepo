  "Diver-1673-XXXX": {
    "id": "Diver-1673-XXXX",
    "name": "Age Discrimination Employment Act of 1967",
    "category": "Diversity/Affirmative Action",
    "description": "It is unlawful for a university to fail to hire, discharge, segregate, classify, or otherwise discriminate against any individual with respect to compensation, terms, conditions or privileges of employment because of age.",
    "version": "1.0.0",
