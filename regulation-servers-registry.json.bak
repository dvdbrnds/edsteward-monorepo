    }
  },
  "Infor-1719-XXXX": {
    "id": "Infor-1719-XXXX",
    "name": "Telemarketing",
    "category": "Information Technology",
    "description": "A tax-exempt nonprofit University is exempt from the Do-Not-Call-Registry, but may not call any residential telephone subscriber before 8 a.m. or after 9 p.m. local time at the called party's location.",
