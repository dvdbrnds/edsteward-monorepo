  "Admis-3962-XXXX": {
    "id": "Admis-3962-XXXX",
    "name": "Higher Education Act: Readmission Requirements for Servicemembers",
    "category": "Admissions",
    "description": "Requires that the University readmit students who left in order to join the military. The student must be readmitted in the same academic status. Generally, the length of absence cannot be greater than five (5) years. Exceptions to this law include those veterans receiving a dishonorable discharge or bad conduct charge, those who were court marshaled, and those who the University is reasonably unable to prepare to resume or complete their program.",
    "version": "1.0.0",
    "statute": "3962",
    "statuteReference": "20 U.S.C. § 1091c",
    "regulation": "34 C.F.R. § 668.18",
    "regulationReference": "34 C.F.R. § 668.18",
    "deadline": "Not Applicable",
    "deadlineType": "14-No Deadline",
    "validationFrequency": "asNeeded",
    "server": {
      "port": 3224,
      "running": true,
      "lastStarted": "2025-04-24T22:00:45.921Z",
      "url": "http://localhost:3224/mcp"
    }
  },
  "Admis-3963-XXXX": {
    "id": "Admis-3963-XXXX",
    "name": "Section 504 of The Rehabilitation Act of 1973",
    "category": "Admissions",
    "description": "Prohibits discrimination on the basis of disability at any federally-funded institution. This covers admissions, recruitment, educational and/or academic programs and services, housing and non-academic programs and services such as counseling, placement, physical education and athletics, student clubs and organizations. This list is not exhaustive.",
    "version": "1.0.0",
    "statute": "3963",
    "statuteReference": "29 U.S.C. § 794",
    "regulation": "34 C.F.R. § 104.42",
    "regulationReference": "34 C.F.R. § 104.42",
    "deadline": "",
    "deadlineType": "1-Jan",
    "validationFrequency": "annual",
    "server": {
      "port": 3225,
      "running": true,
      "lastStarted": "2025-04-24T22:00:45.922Z",
      "url": "http://localhost:3225/mcp"
    }
  },
  "Admis-1633-XXXX": {
    "id": "Admis-1633-XXXX",
    "name": "Title IX of the Education Amendment of 1972",
    "category": "Admissions",
    "description": "Prohibits discrimination on the basis of sex in the admission of education programs or activities receiving federal financial assistance including employment.\n\n \tUnder the Title IX common rule, a recipient may not discriminate against any person on the basis of sex in the counseling or guidance of students or applicants for admission. Specifically, in appraising or counseling students, a recipient must not use different testing or other materials on the basis of sex or use materials that permit or require different treatment of students on the basis of sex. Such different materials may be used, however, where they cover the same occupational interest areas and their use is shown to be essential to eliminate sex bias.\n\n \tAny grievance records relating to a Title IX violation or complaint must be retained for the period of time cited in state law for personal injury actions.",
    "version": "1.0.0",
    "statute": "1633",
    "statuteReference": "20 U.S.C. §§ 1681-1688",
    "regulation": "34 C.F.R. § 106 Subpart C",
    "regulationReference": "34 C.F.R. § 106 Subpart C, 45 C.F.R. § 618 Subpart C, 45 C.F.R. § 86 Subpart C",
    "deadline": "Not Applicable",
    "deadlineType": "14-No Deadline",
    "validationFrequency": "asNeeded",
    "server": {
      "port": 3226,
      "running": true,
      "lastStarted": "2025-04-24T22:00:45.921Z",
      "url": "http://localhost:3226/mcp"
    }
  },
  "Admis-1704-XXXX": {
    "id": "Admis-1704-XXXX",
    "name": "Title VI of the Civil Rights Act of 1964",
    "category": "Admissions",
    "description": "Prohibits discrimination based on race, color, or national origin in the admission of educational and/or academic programs or activities receiving federal financial assistance.",
    "version": "1.0.0",
    "statute": "1704",
    "statuteReference": "42 U.S.C. §§ 2000d-2000d-7",
