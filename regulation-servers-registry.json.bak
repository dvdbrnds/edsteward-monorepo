  "Acade-1692-XXXX": {
    "id": "Acade-1692-XXXX",
    "name": "Age Discrimination Act of 1975",
    "category": "Academic Programs",
    "description": "Prohibits discrimination based on age in educational or academic programs or activities that receive federal financial assistance.\n\n \tProhibits retaliation for filing a complaint with OCR or participating in a mediation or investigation of a violation, or for advocating for a right protected by the Act.",
    "version": "1.0.0",
    "statute": "1692",
    "statuteReference": "42 U.S.C. §§ 6101-6107",
