  "Diver-1765-XXXX": {
    "id": "Diver-1765-XXXX",
    "name": "Genetic Information Non-Discrimination Act of 2008",
    "category": "Diversity/Affirmative Action",
    "description": "Prohibits use of genetic information in employment decision-making.\n\n \tRequires that genetic information be maintained as a confidential medical record, and places strict limits on disclosure of genetic information.",
