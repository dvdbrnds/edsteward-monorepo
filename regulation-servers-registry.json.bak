      "lastStarted": "2025-04-24T22:00:50.495Z",
      "url": "http://localhost:3406/mcp"
    }
  },
  "Resea-1695-XXXX": {
    "id": "Resea-1695-XXXX",
    "name": "National Science Foundation Research Misconduct Policies",
    "category": "Research",
    "description": "A finding of research misconduct requires that: (1) there be a significant departure from accepted practices of the relevant research community; (2) the research misconduct be committed intentionally, or knowingly, or recklessly; and (3) the allegation be proven by a preponderance of evidence.",
    "version": "1.0.0",
    "statute": "1695",
    "statuteReference": "42 U.S.C. § 1870(a)",
