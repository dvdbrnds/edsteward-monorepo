  "Tax-1676-XXXX": {
    "id": "Tax-1676-XXXX",
    "name": "Foreign Bank Accounts and Tax Filings",
    "category": "Tax",
    "description": "US institutions and citizens that have an ownership interest in foreign bank accounts, or US citizens with signature authority over a foreign bank account have to file form TD F 90.22-1 (FBAR).\n\n \tThe latter must report the account on an FBAR even if the foreign financial account is reported on an FBAR filed by the owner of the account (or other person that has a financial interest in the account).",
    "version": "1.0.0",
    "statute": "1676",
    "statuteReference": "31 U.S.C. § 5314(a)",
