  "Priva-1746-XXXX": {
    "id": "Priva-1746-XXXX",
    "name": "HIPAA",
    "category": "Privacy & Information Security",
    "description": "Establishes national standards to protect individuals' medical records and other personal health information.\n\n \tRequires appropriate safeguards to protect the privacy of personal health information, and sets limits and conditions on the uses and disclosures that may be made of such information without patient authorization.\n\n \tGives patients rights to examine and obtain a copy of their health records, and to request corrections.",
