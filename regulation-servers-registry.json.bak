  "Priva-1587-XXXX": {
    "id": "Priva-1587-XXXX",
    "name": "Gramm Leach Bliley Act (GLBA)",
    "category": "Privacy & Information Security",
    "description": "Governs the collection, disclosure, and protection of consumers' personal information and personally identifiable information.\n\n \tRequires institutions that offer consumers financial products or services like loans, financial or investment advice, or insurance to explain their information-sharing practices to their customers and to safeguard sensitive data.",
