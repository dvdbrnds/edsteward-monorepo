      "port": 3361,
      "running": true,
      "lastStarted": "2025-04-24T22:00:49.354Z",
      "url": "http://localhost:3361/mcp"
    }
  },
  "Housi-1633-XXXX": {
    "id": "Housi-1633-XXXX",
    "name": "Title IX of the Education Amendment of 1972",
    "category": "Housing",
    "description": "Under the Title IX common rule, a recipient may not apply different rules or regulations, impose different fees or requirements, or offer different services or benefits related to housing based on sex. However, a recipient may provide separate housing on the basis of sex if such housing is both proportionate in quantity to the number of students of each sex applying for the housing and comparable in quality and cost to the student.\n\n \tAny grievance records relating to a Title IX violation or complaint must be retained for the period of time cited in state law for personal injury actions.",
    "version": "1.0.0",
    "statute": "1633",
    "statuteReference": "20 U.S.C. §§ 1681-1688",
    "regulation": "28 C.F.R. §§ 42.201-42.215",
    "regulationReference": "28 C.F.R. §§ 42.201-42.215, 34 C.F.R. § 106, 29 C.F.R. § 1604, 45 C.F.R. § 86",
    "deadline": "Not Applicable",
