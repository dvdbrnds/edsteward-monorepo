  "Contr-16001687-XXXX": {
    "id": "Contr-16001687-XXXX",
    "name": "Copeland Anti-Kickback Act",
    "category": "Contracts & Procurement",
    "description": "Prohibits inducement of kickbacks from public works employees.\n\n \tRequires contractors and subcontractors on public buildings or works financed by loans or grants from the U.S. to furnish a weekly statement of wages paid. This requirement does not apply to any contract of $2,000 or less.",
    "version": "1.0.0",
    "statute": "1600,1687",
    "statuteReference": "18 U.S.C. § 874, 40 U.S.C. § 3145",
