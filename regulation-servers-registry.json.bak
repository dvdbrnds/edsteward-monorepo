    }
  },
  "Fundr-1619-XXXX": {
    "id": "Fundr-1619-XXXX",
    "name": "Higher Education Act: Code of Conduct",
    "category": "Fundraising & Development",
    "description": "An institution that participates in Title IV programs must have a code of conduct for financial aid practices that prohibits conflicts of interest, is published prominently on the university's website, and is distributed annually to relevant personnel.",
