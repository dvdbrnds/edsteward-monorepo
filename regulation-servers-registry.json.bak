  "Grant-17603960-XXXX": {
    "id": "Grant-17603960-XXXX",
    "name": "Federal Funding Accountability and Transparency Act of 2006 (FFATA)",
    "category": "Grants Management",
    "description": "The Act requires full disclosure to public of all entities/orgs receiving federal funds via single searchable website accessible to public at no cost (www.USASpending.gov).\n\n \tFor each award the University must include: 1) Name of receiving entity; 2) amount; 3) transaction type, funding agency and program source; 4) location of recipient entity and primary location of performance; 5) reporting on executive compensation for first-tier sub award recipients; and 6) unique recipient entity identifier.\n\n \tReporting requirements apply to vendors as well as sub-grantees.",
    "version": "1.0.0",
    "statute": "1760,3960",
    "statuteReference": "Public Law No. 109-282, P.L. 110-252, § 6202",
    "regulation": "",
