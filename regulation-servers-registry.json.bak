  "Housi-1701-XXXX": {
    "id": "Housi-1701-XXXX",
    "name": "Americans with Disabilities Act of 1990",
    "category": "Housing",
    "description": "Requires reasonable accommodations to allow a qualified person with a disability to participate fully in the programs and activities of the university.\n\n \tRequires that universities ensure that no individual with a disability is discriminated against on the basis of a disability in the full and equal enjoyment of the universities services and facilities, including university housing.\n\n \tEnforced by multiple federal agencies, including the Department of Justice, Department of Labor, and the EEOC.",
    "version": "1.0.0",
    "statute": "1701",
    "statuteReference": "42 U.S.C. §§ 12101-12213",
