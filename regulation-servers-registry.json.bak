  "Admis-1607-XXXX": {
    "id": "Admis-1607-XXXX",
    "name": "Higher Education Act: Institutional and Financial Assistance Information for Students",
    "category": "Admissions",
    "description": "Requires institutions to provide each student, upon enrollment, with a \"separate, clear, and conspicuous written notice\" that provides information on the federal aid eligibility penalties associated with drug-related offenses.",
