  "Wages-1656-XXXX": {
    "id": "Wages-1656-XXXX",
    "name": "Federal Unemployment Tax Act",
    "category": "Wages",
    "description": "Provides for payments of unemployment compensation to workers who have lost their jobs.\n\n \tIf your FUTA tax is more than $500 for the calendar year, you must deposit at least one quarterly payment.  If not, alternate rules apply.",
