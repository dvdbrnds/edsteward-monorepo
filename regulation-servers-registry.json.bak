    }
  },
  "Contr-1608-XXXX": {
    "id": "Contr-1608-XXXX",
    "name": "Higher Education Act: Foreign Gift and Contract Reports",
    "category": "Contracts & Procurement",
    "description": "Whenever an institution is owned or controlled by a foreign source, or receives gifts from or enter into contracts with a foreign source totaling more than $250,000 within a calendar year, the institution shall file a disclosure report with the Secretary of Education on January 31 or July 31, whichever is sooner. This page serves as a repository for all relevant data, information, guidance, and training related to the required foreign gift and contract reporting.",
    "version": "1.0.0",
    "statute": "1608",
    "statuteReference": "20 U.S.C. § 1011f",
