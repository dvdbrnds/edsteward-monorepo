    }
  },
  "Infor-1749-XXXX": {
    "id": "Infor-1749-XXXX",
    "name": "No Electronic Theft Act",
    "category": "Information Technology",
    "description": "Makes it a criminal offense to willfully infringe a copyright by sharing, as well as selling, pirated software with a retail value of $1,000 or more.\n\n \tOffenders will be subject to up to five years in prison, and a $250,000 fine.",
