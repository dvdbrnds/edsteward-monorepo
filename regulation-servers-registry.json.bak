  "Diver-1732-XXXX": {
    "id": "Diver-1732-XXXX",
    "name": "Immigration and Nationality Act",
    "category": "Diversity/Affirmative Action",
    "description": "The INA, as amended, sets forth the laws governing the admission and employment of foreign nationals in the United States, including provisions that address employment eligibility and employment verification.",
