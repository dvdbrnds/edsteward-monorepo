  },
  "Emplo-17701691-XXXX": {
    "id": "Emplo-17701691-XXXX",
    "name": "Patient Protection and Affordable Care Act",
    "category": "Employee Benefits",
    "description": "Beginning in 2015, under IRC 4980H applicable large employers (generally those with 50 or more employees) must pay a tax penalty if\n\n\n(1) they do not offer health insurance coverage to substantially all of their full-time employees or\n(2) the coverage they do offer is not affordable or does not provide a certain minimum level of benefits.\n\n \tA full-time employee under the employer mandate is defined as a common law employee who is employed an average of at least 30 hours per week.\n\n \tThe final regulations offer some specific guidance to higher education institutions with respect to counting the hours worked by certain adjunct faculty and student workers.",
    "version": "1.0.0",
    "statute": "1770,1691",
    "statuteReference": "Public Law No. 111-148, 42 U.S.C §§ 18001-18122",
    "regulation": "26 C.F.R. § 1",
    "regulationReference": "26 C.F.R. § 1, 26 C.F.R. § 54, 26 C.F.R. § 301",
