  "Infor-1721-XXXX": {
    "id": "Infor-1721-XXXX",
    "name": "Communications Assistance for Law Enforcement Act (CALEA)",
    "category": "Information Technology",
    "description": "CALEA requires a \"telecommunications carrier,\" as defined by the Act, to ensure that equipment, facilities, or services that allow a customer or subscriber to \"originate, terminate, or direct communications,\" enable law enforcement officials to conduct electronic surveillance pursuant to court order or other lawful authorization.",
