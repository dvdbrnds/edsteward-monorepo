  "Intel-1681-XXXX": {
    "id": "Intel-1681-XXXX",
    "name": "Bayh-Dole Act of 1980",
    "category": "Intellectual Property and Technology Transfer",
    "description": "Establishes a uniform policy for the disposition and licensing of rights to patentable inventions discovered in the course of federally-funded research.",
