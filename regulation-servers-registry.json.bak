  "Fundr-1747-XXXX": {
    "id": "Fundr-1747-XXXX",
    "name": "Philanthropy Protection Act of 1995",
    "category": "Fundraising & Development",
    "description": "Requires the university to provide a disclosure statement to all annuitants in a Gift Annuity Fund and also to provide the same to all prospective donors at the time of solicitation, using a letter or pamphlet format.\n\n \tProhibits the payment of commissions or remuneration to anyone based on the value of a charitable gift annuity given to a public charity.",
