  "Expor-3955-XXXX": {
    "id": "Expor-3955-XXXX",
    "name": "Export Administration Act of 1979",
    "category": "Export Controls",
    "description": "Primary statutory basis for the Export Administration Regulations, which regulate the export of certain § dual use § item, i.e. items that are capable of both civilian and military use.",
