  "Contr-1675-XXXX": {
    "id": "Contr-1675-XXXX",
    "name": "Byrd Amendment",
    "category": "Contracts & Procurement",
    "description": "Prohibits grantees from lobbying with federal funds.\n\n \tRequires disclosure of lobbying activities when receiving federal contracts, grants, loans or cooperative agreements.",
