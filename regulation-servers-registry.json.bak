  "Accou-1608-XXXX": {
    "id": "Accou-1608-XXXX",
    "name": "Higher Education Act – Disclosure of Foreign Gifts",
    "category": "Accounting",
    "description": "The University is required to submit a disclosure report for gifts and contracts of $250,000 or more with a foreign source to the Department of Education. This page serves as a repository for all relevant data, information, guidance, and training related to the required foreign gift and contract reporting.",
