  "Discr-1737-XXXX": {
    "id": "Discr-1737-XXXX",
    "name": "Equal Employment Opportunity",
    "category": "Discrimination",
    "description": "Federal contractors must not discriminate in employment decisions on the basis of race, religion, color, sex, or national origin.\n\n \tCovered institutions must take affirmative action to ensure applicants are treated without regard to such factors.",
