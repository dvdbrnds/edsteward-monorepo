  "Priva-1580-XXXX": {
    "id": "Priva-1580-XXXX",
    "name": "Children’s Online Privacy Protection Act of 1998 (COPPA)",
    "category": "Privacy & Information Security",
    "description": "Regulates the collection, use and protection of information from children (up to age 13) via websites or on-line services.\n\n \tAny for-profit websites that are directed to and collect personal info from children must, among other requirements: 1) Provide notice on the website of what info is collected, how it's used, and the operator's disclosure practices; 2) respond to parental requests for info; 3) maintain procedures to protect confidentiality, security and integrity of personal information collected.",
    "version": "1.0.0",
    "statute": "1580",
    "statuteReference": "15 U.S.C. §  6501",
    "regulation": "16 C.F.R. 312",
