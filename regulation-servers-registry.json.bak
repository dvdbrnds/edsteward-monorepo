    }
  },
  "Grant-17673934-XXXX": {
    "id": "Grant-17673934-XXXX",
    "name": "Federal Awardee Performance and Integrity Information System (FAPIIS)",
    "category": "Grants Management",
    "description": "Federal Awardee Performance and Integrity Information System (FAPIIS) is a federally-mandated information system that contains specific information on the integrity and ethical performance of covered Federal contractors and grantees.",
