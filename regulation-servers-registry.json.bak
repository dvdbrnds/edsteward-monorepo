  "Accou-1590-XXXX": {
    "id": "Accou-1590-XXXX",
    "name": "Clayton Antitrust Act of 1914",
    "category": "Accounting",
    "description": "Enacted as a supplement to the Sherman Act.\n\n \tProhibits price discrimination; conditioning sales on exclusive dealing; mergers and acquisitions when they may substantially reduce competition; and serving on the board of directors for two competing companies.",
