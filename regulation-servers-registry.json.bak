      "lastStarted": "2025-04-24T22:00:50.953Z",
      "url": "http://localhost:3424/mcp"
    }
  },
  "Tax-1657-XXXX": {
    "id": "Tax-1657-XXXX",
    "name": "Industrial Alcohol User Permits and Special Tax",
    "category": "Tax",
    "description": "Institutions that procure, use, sell, and/or recover denatured distilled spirits for industrial purposes are required to obtain a permit from the ATF and pay an occupational tax of $250 per year.\n\n \tHowever, a scientific university, college of learning, or institution of scientific research which holds a permit to procure and use specially denatured spirits is exempt from payment of the tax if: (i) The institution procures less than 25 gallons of specially denatured spirits per calendar year; and (ii) such spirits are procured for use exclusively for experimental or research use and not for consumption or sale.",
    "version": "1.0.0",
    "statute": "1657",
    "statuteReference": "26 U.S.C. §§ 5001-5692",
    "regulation": "27 C.F.R. § 1",
    "regulationReference": "27 C.F.R. § 1",
