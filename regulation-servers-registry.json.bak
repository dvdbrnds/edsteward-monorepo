  "Acade-1701-XXXX": {
    "id": "Acade-1701-XXXX",
    "name": "Americans with Disabilities Act of 1990",
    "category": "Academic Programs",
    "description": "Provides broad nondiscrimination protection in employment, public services, and public accommodations (including colleges and universities) for individuals with disabilities.\n\n \tRequires reasonable accommodations (e.g., a modification or adjustment to the status quo inherent in the program or activity) to allow a qualified person with a disability to participate fully in the educational or academic programs and activities of the university.\n\n \tEnforced by multiple federal agencies, including the U.S. Department of Justice, U.S. Department of Labor, U.S. Department of Education, and the U.S. Equal Employment Opportunity Commission.",
    "version": "1.0.0",
    "statute": "1701",
    "statuteReference": "42 U.S.C. §§ 12101-12213",
    "regulation": "28 C.F.R. § 35",
    "regulationReference": "28 C.F.R. § 35, 28 C.F.R. § 36, 29 C.F.R. § 1640, 29 C.F.R. § 1630",
    "deadline": "Not Applicable",
    "deadlineType": "14-No Deadline",
    "validationFrequency": "asNeeded",
    "server": {
      "port": 3201,
      "running": true,
      "lastStarted": "2025-04-24T22:00:45.319Z",
      "url": "http://localhost:3201/mcp"
    }
  },
  "Acade-1605-XXXX": {
    "id": "Acade-1605-XXXX",
    "name": "Higher Education Act: Institutional and Financial Assistance Information for Students",
    "category": "Academic Programs",
    "description": "Among other things, requires the following annual disclosures to enrolled and prospective students:\nf) diversity statistics;\ng) retention rates;\nh) employment placement data; and\ni) fire safety report.\nc) transfer of credit policies;",
