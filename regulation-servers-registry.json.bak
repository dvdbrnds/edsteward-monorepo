  "Discr-1715-XXXX": {
    "id": "Discr-1715-XXXX",
    "name": "Title VII of the Civil Rights Act of 1964",
    "category": "Discrimination",
    "description": "Title VII prohibits discrimination in hiring, firing, training, promotion, discipline, or other workplace decisions on the basis of an employee or applicant's race, color, sex, national origin, or religion.\n\n \tSexual harassment is also prohibited under this law.\n\n \tAllows for compensatory and punitive damages and jury trials when intentional employment discrimination can be shown with respect to one of the Title VII protected classes or with respect to protection offered by the Americans with Disabilities Act or the Rehabilitation Act.\n\n \tProhibits discrimination on the basis of pregnancy, childbirth, or related illness in employment opportunities, health or disability insurance programs, or sick leave plans.",
    "version": "1.0.0",
    "statute": "1715",
    "statuteReference": "42 USCU.S.C. §§ 2000e-2000e-17",
    "regulation": "29 C.F.R. § 42.101-112",
    "regulationReference": "29 C.F.R. § 42.101-112, 41 C.F.R. § 60-1.1-60.1.47",
    "deadline": "Not Applicable",
    "deadlineType": "14-No Deadline",
    "validationFrequency": "asNeeded",
    "server": {
      "port": 3270,
      "running": true,
      "lastStarted": "2025-04-24T22:00:47.059Z",
      "url": "http://localhost:3270/mcp"
    }
  },
  "Discr-4207-XXXX": {
    "id": "Discr-4207-XXXX",
    "name": "Pregnant Workers Fairness Act (PWFA)",
    "category": "Discrimination,Human Resources",
    "description": "<li style=\"list-style-type: none;\">\n\n \tMakes it an unlawful employment practice for a covered entity to (1) deny reasonable accommodations to known limitations related to pregnancy, childbirth, or related medical conditions, unless the entity can demonstrate an undue hardship; (2) require a qualified employee to accept an accommodation without engaging in an interactive process; (3) deny employment opportunities based on the need to make reasonable accommodations; (4) require a qualified employee to take leave if another reasonable accommodation can be provided; and (5) take an adverse action in the terms, conditions, or privileges of employment against a qualified employee because of a request for or use of an accommodation.",
    "version": "1.0.0",
    "statute": "4207",
    "statuteReference": "42 U.S.C. Chapter 21G",
    "regulation": "29 C.F.R. Part 1636",
    "regulationReference": "29 C.F.R. Part 1636",
    "deadline": "",
    "deadlineType": "1-Jan",
    "validationFrequency": "annual",
    "server": {
      "port": 3271,
      "running": true,
      "lastStarted": "2025-04-24T22:00:47.059Z",
      "url": "http://localhost:3271/mcp"
    }
  },
