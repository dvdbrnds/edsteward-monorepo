    }
  },
  "Tax-16261652-XXXX": {
    "id": "Tax-16261652-XXXX",
    "name": "Reporting of Payments of Royalties",
    "category": "Tax",
    "description": "Those who make payments to attorneys aggregating $600 or more per calendar year in connection with legal services must file an information return for such payments.\n\n \tThis requirement applies whether or not the services were performed for the payor, so for example, if the university was a defendant in a lawsuit, and was required to pay attorney's fees, this rule would apply.\n\n \tThe filer must also provide to the attorney a written statement of the information required to be included on the return.\n\n \tNote that employers must report entire settlement amounts, including the amount paid to the attorneys, as income to the plaintiff, and also prepare a Form 1099 reporting the amount paid to the attorneys as income to the attorneys.",
    "version": "1.0.0",
    "statute": "1626,1652",
    "statuteReference": "20 U.S.C. § 6041, 26 U.S.C. § 6050N",
    "regulation": "26 C.F.R. § 1.6045-5",
    "regulationReference": "26 C.F.R. § 1.6045-5, 26 C.F.R. § 1.6041-6",
    "deadline": "",
    "deadlineType": "1-Jan",
    "validationFrequency": "annual",
    "server": {
      "port": 3430,
      "running": true,
      "lastStarted": "2025-04-24T22:00:51.106Z",
      "url": "http://localhost:3430/mcp"
    }
  },
  "Tax-1643-XXXX": {
    "id": "Tax-1643-XXXX",
    "name": "Unrelated Business Income (UBIT)",
    "category": "Tax",
    "description": "Unrelated business income is income from a trade or business, regularly carried on, that is not substantially related to the charitable, educational, or other purpose that is the basis of the organization's exemption.\n\n \tAn exempt organization that has $1,000 or more of gross income from an unrelated business must file Form 990-T. An organization must pay estimated tax if it expects its tax for the year to be $500 or more.  All other organizations must file Form 990-T by the 15th day of the 5th month after the end of their tax year.",
    "version": "1.0.0",
    "statute": "1643",
    "statuteReference": "26 U.S.C. 511(a)(2)",
    "regulation": "26 C.F.R. § 1.511-1",
    "regulationReference": "26 C.F.R. § 1.511-1, 26 C.F.R. § 1.513-4",
    "deadline": "Not Applicable",
    "deadlineType": "14-No Deadline",
    "validationFrequency": "asNeeded",
    "server": {
      "port": 3431,
      "running": true,
      "lastStarted": "2025-04-24T22:00:51.182Z",
      "url": "http://localhost:3431/mcp"
    }
  },
  "Wages-1582-XXXX": {
    "id": "Wages-1582-XXXX",
    "name": "Consumer Credit Protection Act, Title III (CCPA) – Garnishments",
    "category": "Wages",
    "description": "Per Title III of the CCPA the maximum part of an employee's total disposable earnings subject to garnishment in any workweek may not exceed the lesser of 25% of disposable earnings for that week or the amount by which disposable earnings for that week exceeds 30 times the federal minimum wage rate in effect at the time the earnings are payable. 1674 prohibits firing an employee because of garnishment and imposes a $1,000 fine for doing so.",
    "version": "1.0.0",
    "statute": "1582",
