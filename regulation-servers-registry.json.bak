  "Infor-1766-XXXX": {
    "id": "Infor-1766-XXXX",
    "name": "Higher Education Opportunity Act",
    "category": "Information Technology",
    "description": "Section 488 requires institutions to develop plans to detect and prevent unauthorized distribution of copyrighted material on information technology systems, including offering alternatives to illegal-downloading or peer-to-peer distribution of intellectual property.",
