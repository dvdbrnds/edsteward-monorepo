  "Expor-1640-XXXX": {
    "id": "Expor-1640-XXXX",
    "name": "Arms Export Control Act of 1976",
    "category": "Export Controls",
    "description": "Provides the authority to control the export of defense articles and services, and charges the President to exercise this authority. Executive Order 11958, as amended, delegated this statutory authority to the Secretary of State.",
