    }
  },
  "Contr-1690-XXXX": {
    "id": "Contr-1690-XXXX",
    "name": "Anti-Kickback Act of 1986",
    "category": "Contracts & Procurement",
    "description": "Prohibits any payment or gratuity made for the purpose of inducing award of a subcontract or prime contract with the federal government.",
