  "Wages-1777-XXXX": {
    "id": "Wages-1777-XXXX",
    "name": "Qualified Tuition Reductions",
    "category": "Wages",
    "description": "A qualified tuition reduction is any reduction in tuition provided to an employee for the education of an employee or certain relatives of the employee at the institution the employee works at or another qualified institution.\n\n \tA qualified tuition reduction is tax-free.\n\n \tThe tuition must be for education below the graduate level, with an exception for graduate students engaged in teaching or research at the university.",
