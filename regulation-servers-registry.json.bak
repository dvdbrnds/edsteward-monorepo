    }
  },
  "Acade-1633-XXXX": {
    "id": "Acade-1633-XXXX",
    "name": "Title IX of the Education Amendment of 1972",
    "category": "Academic Programs",
    "description": "Prohibits discrimination on the basis of sex in education programs or activities receiving federal financial assistance including employment.\n\n \tAny grievance records relating to a Title IX violation or complaint must be retained for the period of time cited in state law for personal injury actions.",
    "version": "1.0.0",
    "statute": "1633",
    "statuteReference": "20 U.S.C. §§ 1681-1688",
    "regulation": "28 C.F.R. §§ 42.201-42.215, 42.601-42.613",
    "regulationReference": "28 C.F.R. §§ 42.201-42.215, 42.601-42.613, 34 C.F.R. § 106, 29 C.F.R. § 1604, 45 C.F.R. § 86",
