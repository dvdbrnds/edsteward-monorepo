  "Emplo-1764-XXXX": {
    "id": "Emplo-1764-XXXX",
    "name": "Medicare, Medicaid, and SCHIP Extension Act of 2007",
    "category": "Employee Benefits",
    "description": "The University, as a provider of self-insured group health and worker's compensation plans, must determine whether a claimant is entitled to benefits under Medicare on any basis, and if so, must submit to the Secretary of the Department of Health and Human Services the claimant's identity and other information (e.g. SSNs, date of birth, sex, and address) specified by the Secretary for coordination of benefits and recovery claims purposes.",
