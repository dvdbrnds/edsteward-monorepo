  "Diver-1692-XXXX": {
    "id": "Diver-1692-XXXX",
    "name": "Age Discrimination Act of 1975",
    "category": "Diversity/Affirmative Action",
    "description": "Prohibits discrimination based on age in educational or academic programs or activities that receive federal financial assistance.\n\n \tProhibits retaliation for filing a complaint with OCR or for advocating for a right protected by the Act.",
