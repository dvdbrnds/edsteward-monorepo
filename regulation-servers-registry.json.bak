  "Diver-1771-XXXX": {
    "id": "Diver-1771-XXXX",
    "name": "Lilly Ledbetter Fair Pay Act of 2009",
    "category": "Diversity/Affirmative Action",
    "description": "An individual subjected to compensation discrimination under Title VII of the Civil Rights Act of 1964, the Age Discrimination in Employment Act of 1967, or the Americans with Disabilities Act of 1990 may file a charge within 180 (or 300) days of any of the following: 1) when a discriminatory compensation decision or other discriminatory practice affecting compensation is adopted; 2) when the individual becomes subject to a discriminatory compensation decision or other discriminatory practice affecting compensation; or 3) when the individual's compensation is affected by the application of a discriminatory compensation decision or other discriminatory practice, including each time the individual receives compensation that is based in whole or part on such compensation decision or other practice.\n\n \tThe Act has a retroactive effective date of May 28, 2007, and applies to all claims of discriminatory compensation pending on or after that date.",
    "version": "1.0.0",
    "statute": "1771",
    "statuteReference": "Public Law No. 111-2",
    "regulation": "",
    "regulationReference": "",
    "deadline": "Not Applicable",
    "deadlineType": "14-No Deadline",
    "validationFrequency": "asNeeded",
    "server": {
      "port": 3280,
      "running": true,
      "lastStarted": "2025-04-24T22:00:47.289Z",
      "url": "http://localhost:3280/mcp"
    }
  },
  "Diver-1665-XXXX": {
    "id": "Diver-1665-XXXX",
    "name": "Section 504 of The Rehabilitation Act of 1973",
    "category": "Diversity/Affirmative Action",
    "description": "Prohibits discrimination on the basis of disability at any federally-funded institution. This covers admissions, recruitment, programs and services.\n\n \tIf an existing facility is not accessible, redesign of equipment, reassignment of classes or other services to accessible buildings is an alternative to new construction.\n\n \tNewly constructed facilities must be readily accessible to persons with disabilities.\n\n \tEach facility or part of a facility which is altered in a manner that affects or could affect the usability of the facility or part of the facility shall, to the maximum extent feasible, be altered in such manner that the altered portion of the facility is readily accessible to and usable by persons with disabilities.\n\n \tEnforced by the Office for Civil Rights of the Department of Education.",
    "version": "1.0.0",
    "statute": "1665",
    "statuteReference": "29 U.S.C. § 701",
    "regulation": "34 C.F.R. § 104",
    "regulationReference": "34 C.F.R. § 104, 45 C.F.R. § 84",
    "deadline": "Not Applicable",
    "deadlineType": "14-No Deadline",
    "validationFrequency": "asNeeded",
