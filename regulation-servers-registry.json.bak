  "Envir-3661-XXXX": {
    "id": "Envir-3661-XXXX",
    "name": "Residential Lead-Based Paint Hazard Reduction Act of 1992",
    "category": "Environmental Health and Safety",
    "description": "Regulations apply to owners of more than four residential housing units built before 1978.\n\n\nBefore ratification of a contract for housing sale or lease, sellers and landlords must:\n\n \t<li style=\"list-style-type: none\">\n\n \tGive an EPA-approved information pamphlet on identifying and controlling lead-based paint hazards (\"Protect Your Family From Lead In Your Home\" pamphlet).\n\n \tDisclose any known information concerning lead-based paint or lead-based paint hazards. The seller or landlord must also disclose information such as the location of the lead-based paint and/or lead-based paint hazards, and the condition of the painted surfaces.\n\n \tProvide any records and reports on lead-based paint and/or lead-based paint hazards which are available to the seller or landlord (for multi-unit buildings, this requirement includes records and reports concerning common areas and other units, when such information was obtained as a result of a building-wide evaluation).\n\n \tInclude an attachment to the contractor lease (or insert language in the lease itself) which includes a Lead Warning Statement and confirms that the seller or landlord has complied with all notification requirements. This attachment is to be provided in the same language used in the rest of the contract. Sellers or landlords, and agents, as well as homebuyers or tenants, must sign and date the attachment.\n\n \tSellers must provide homebuyers a 10-day period to conduct a paint inspection or risk assessment for lead-based paint or lead-based paint hazards. Parties may mutually agree, in writing, to lengthen or shorten the time period for inspection. Homebuyers may waive this inspection opportunity.\n\n \tSellers and lessors must retain a copy of the disclosures for no less than three years from the date of sale or the date the leasing period begins.",
    "version": "1.0.0",
    "statute": "3661",
    "statuteReference": "42 U.S.C. § 4851 et seq.",
    "regulation": "24 C.F.R. § 35.80 et seq.",
    "regulationReference": "24 C.F.R. § 35.80 et seq., (HUD), 40 C.F.R. §745.100",
    "deadline": "Not Applicable",
    "deadlineType": "14-No Deadline",
    "validationFrequency": "asNeeded",
    "server": {
      "port": 3308,
      "running": true,
      "lastStarted": "2025-04-24T22:00:48.056Z",
      "url": "http://localhost:3308/mcp"
    }
  },
  "Envir-1711-XXXX": {
    "id": "Envir-1711-XXXX",
    "name": "Resource Conservation and Recovery Act",
    "category": "Environmental Health and Safety",
    "description": "Gives the EPA authority to control hazardous waste generation, transportation, treatment, storage and disposal.\n\n \tIf the university is a hazardous waste generator it must:\n\n \tCertify there is a program in place to reduce quantity and toxicity of waste to the degree economically practicable;\n\n \tEstablish record-keeping practices for waste generated; 3. Use appropriate containers and labeling practices for storage, transport or disposal, and use a manifest system.\n\n \tIf the university is a small quantity generator, it must provide to the EPA every year setting out quantities and nature of waste generated, how disposed, efforts to reduce volume and toxicity, and changes in volume and toxicity achieved.\n\n \tUnderground Storage Tank training must be conducted every 7 years.",
    "version": "1.0.0",
    "statute": "1711",
    "statuteReference": "42 U.S.C. §§ 6901-6992k",
    "regulation": "40 C.F.R. § 98.250",
    "regulationReference": "40 C.F.R. § 98.250, 40 C.F.R. § 260",
    "deadline": "",
    "deadlineType": "9-Sep",
    "validationFrequency": "annual",
    "server": {
      "port": 3309,
      "running": true,
      "lastStarted": "2025-04-24T22:00:48.055Z",
      "url": "http://localhost:3309/mcp"
    }
  },
  "Envir-1599-XXXX": {
    "id": "Envir-1599-XXXX",
    "name": "The Public Health Security and Bioterrorism Preparedness and Response Act",
    "category": "Environmental Health and Safety",
    "description": "All colleges and universities that possess select agents, which are certain biological agents and toxins, need to register with the Secretary of the U.S. Department of Health and Human Services.\n\n \tRequires prompt notification of the release of a select agent outside of the biocontainment area, or of theft or loss of a select agent.\n\n \tThe university must also deny access to the agents/toxins by restricted persons.",
