    }
  },
  "Accou-1656-XXXX": {
    "id": "Accou-1656-XXXX",
    "name": "Federal Unemployment Tax Act (FUTA)",
    "category": "Accounting",
    "description": "<li style=\"list-style-type: none\">\n\n \tProvides for payments of unemployment compensation to workers who have lost their jobs.\n\n \tIf an employer’s FUTA tax is more than $500 for the calendar year, the employer must deposit at least one quarterly payment.  If not, alternate rules apply. See IRS Publication: Topic Number 759 - Form 940 – Employer's Annual Federal Unemployment (FUTA) Tax Return – Filing and Deposit Requirements",
    "version": "1.0.0",
    "statute": "1656",
    "statuteReference": "26 U.S.C. §§ 3301-3311",
    "regulation": "26 C.F.R. § 31.6011(A)- 3",
    "regulationReference": "26 C.F.R. § 31.6011(A)- 3",
