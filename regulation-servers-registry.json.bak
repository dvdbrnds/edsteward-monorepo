  "Accou-1653-XXXX": {
    "id": "Accou-1653-XXXX",
    "name": "Qualified Tuition and Student Loan Interest Reporting",
    "category": "Accounting",
    "description": "Institutions must report to the IRS\n\n(1) qualified tuition and related expenses and\n(2) student loan interest to the IRS.\n\n \tInstitutions must also provide payors with a statement that includes the tax information furnished to the IRS.",
