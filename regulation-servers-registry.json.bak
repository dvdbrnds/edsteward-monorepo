  "Emplo-1660-XXXX": {
    "id": "Emplo-1660-XXXX",
    "name": "Employee Retirement Income Security Act of 1974 (ERISA)",
    "category": "Employee Benefits",
    "description": "Sets minimum standards for participation, vesting, benefit accrual and funding pension plans.\n\n \tRequires employers to regularly provide participants with information about the plan including information about plan features and funding.\n\n \tRequires accountability of plan fiduciaries and gives participants the right to sue for benefits and breaches of fiduciary duty.",
