  "Resea-4220-XXXX": {
    "id": "Resea-4220-XXXX",
    "name": "Native American Graves Protection and Repatriation Act (NAGPRA)",
    "category": "Research",
    "description": "<li style=\"list-style-type: none;\">\n\n \tRequires federal agencies and institutions that receive federal funding to repatriate or transfer human remains, funerary objects, sacred objects, and objects of cultural patrimony to lineal descendants, Native American tribes and Native Hawaiian organizations.\n\n \tEstablishes procedures for the inadvertent discovery or planned excavation of Native American cultural items on federal or tribal lands.\n\n \tCriminal enforcement codified at 18 U.S. Code § 1170.",
    "version": "1.0.0",
    "statute": "4220",
