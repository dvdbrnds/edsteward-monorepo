  "Disab-1665-XXXX": {
    "id": "Disab-1665-XXXX",
    "name": "Section 504 of The Rehabilitation Act of 1973",
    "category": "Disabilities",
    "description": "Prohibits discrimination on the basis of disability at any federally-funded institution. This covers admissions, recruitment, programs and services.\n\n \tInstitutions must provide equal access to programs and facilities to “otherwise qualified” individuals with disabilities and make reasonable accommodations to allow equal access.\n\n \tExisting facilities can be made compliant through modification, moving classes or other services to more accessible locations, assignment of aids, or other measures.\n\n \tNewly constructed facilities must be readily accessible to persons with disabilities.\n\n \tEach facility or part of a facility which is altered in a manner that affects or could affect the usability of the facility or part of the facility shall, to the maximum extent feasible, be altered in such manner that the altered portion of the facility is readily accessible to and usable by persons with disabilities.\n\n \tEnforced by Office for Civil Rights of the U.S. Department of Education.",
    "version": "1.0.0",
    "statute": "1665",
    "statuteReference": "29 U.S.C. § 701",
    "regulation": "34 C.F.R. § 104",
    "regulationReference": "34 C.F.R. § 104, 45 C.F.R. § 84",
