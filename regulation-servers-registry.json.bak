  "Accou-1778-XXXX": {
    "id": "Accou-1778-XXXX",
    "name": "Uniform Administrative Requirements, Cost Principles, and Audit Requirements for Federal Awards (Uniform Guidance, Super Circular, or Omni Circular)",
    "category": "Accounting",
    "description": "The Uniform Guidance streamlines and consolidates the federal government’s guidance on administrative rules, cost principles, and audit requirements for federal awards (including sponsored research awards and others awarded to institutions) across the entire federal government. Also requires disclosures of potential conflicts of interest or criminal violations.\n\n \tDepartment of Education exceptions to the Uniform Guidance are available here.",
