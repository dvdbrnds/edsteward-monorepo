  "Infor-1718-XXXX": {
    "id": "Infor-1718-XXXX",
    "name": "FCC – Wireless Communications, Licensing",
    "category": "Information Technology",
    "description": "The University's authorization to provide wireless communication services is granted for any or a combination of the following services in a single license: 1) common carrier; 2) non-common carrier; 3) private internal communications; 4) and broadcast services.\n\n \tA license application must be filed with the FCC.",
