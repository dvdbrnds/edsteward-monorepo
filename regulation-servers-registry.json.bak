    "validationFrequency": "asNeeded",
    "server": {
      "port": 3382,
      "running": true,
      "lastStarted": "2025-04-24T22:00:49.886Z",
      "url": "http://localhost:3382/mcp"
    }
  },
  "Lobby-16041748-XXXX": {
    "id": "Lobby-16041748-XXXX",
    "name": "Lobbying Disclosure Act",
    "category": "Lobbying and Political Activities",
    "description": "Requires institutions to register if they employ (as a salaried employee) individuals who make at least two lobbying contacts each six months and devote 20% of their time to lobbying activities and incur expenses for lobbying of $20,000 or more in a six-month period.\n\n \tPermits tax exempt charitable organizations required to report lobbying expenses by the IRC to report, under this law, only good faith estimates of such expenses in order to meet reporting requirements.",
    "version": "1.0.0",
    "statute": "1604,1748",
    "statuteReference": "2 U.S.C. §§ 1601-1614, Public Law No. 104-65, 109 Stat. 691",
    "regulation": "",
    "regulationReference": "",
    "deadline": "",
    "deadlineType": "13-Multiple Deadlines",
    "validationFrequency": "quarterly",
    "server": {
      "port": 3383,
      "running": true,
      "lastStarted": "2025-04-24T22:00:49.961Z",
      "url": "http://localhost:3383/mcp"
    }
  },
  "Lobby-1740-XXXX": {
    "id": "Lobby-1740-XXXX",
    "name": "Political Activities",
    "category": "Lobbying and Political Activities",
    "description": "All section 501(c)(3) organizations are absolutely prohibited from directly or indirectly participating in, or intervening in, any political campaign on behalf of (or in opposition to) any candidate for elective public office.\n\n \tContributions to political campaign funds or public statements of position (verbal or written) made on behalf of the organization in favor of or in opposition to any candidate for public office clearly violate the prohibition against political campaign activity.\n\n \tViolating this prohibition may result in denial or revocation of tax-exempt status and the imposition of certain excise taxes.",
    "version": "1.0.0",
    "statute": "1740",
    "statuteReference": "IRC § 501 (c )(3)",
    "regulation": "",
    "regulationReference": "",
    "deadline": "Not Applicable",
