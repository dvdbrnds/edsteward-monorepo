  "Envir-1714-XXXX": {
    "id": "Envir-1714-XXXX",
    "name": "Comprehensive Environmental Response, Compensation, and Liability Act (CERCLA)",
    "category": "Environmental Health and Safety",
    "description": "Establishes prohibitions and requirements concerning closed and abandoned hazardous waste sites;\n\n \tProvides for liability of persons responsible for releases of hazardous waste at these sites; and\n\n \tEstablishes a trust fund to provide for cleanup when no responsible party can be identified.",
