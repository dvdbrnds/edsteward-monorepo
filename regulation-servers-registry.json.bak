  },
  "Infor-1597-XXXX": {
    "id": "Infor-1597-XXXX",
    "name": "Digital Millennium Copyright Act (DMCA)",
    "category": "Information Technology",
    "description": "Imposes rules prohibiting the circumvention of technological protection measures.\n\n \tSets limitations on copyright infringement liability for online service providers (OSPs).\n\n \tExpands an existing exemption for making copies of computer programs.\n\n \tProvides a significant updating of the rules and procedures regarding archival preservation.",
