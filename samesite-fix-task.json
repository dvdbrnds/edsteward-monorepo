{
  "family": "template-edsteward",
  "taskRoleArn": "arn:aws:iam::259661441422:role/ecsTaskRole",
  "executionRoleArn": "arn:aws:iam::259661441422:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "containerDefinitions": [
    {
      "name": "edsteward-app",
      "image": "259661441422.dkr.ecr.us-east-1.amazonaws.com/edsteward:samesite-fix",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "CUSTOMER_SUBDOMAIN",
          "value": "template"
        },
        {
          "name": "DATABASE_URL",
          "value": "postgresql://neondb_owner:npg_foSr6ixkzw7W@ep-weathered-term-a5rmi9cx-pooler.us-east-2.aws.neon.tech/template_edsteward?sslmode=require"
        },
        {
          "name": "SAML_ENABLED",
          "value": "false"
        },
        {
          "name": "CUSTOMER_NAME",
          "value": "Template University"
        },
        {
          "name": "PRIMARY_COLOR",
          "value": "#dc2626"
        },
        {
          "name": "LOGO_URL",
          "value": "/assets/generic-logo.svg"
        },
        {
          "name": "FAVICON_URL",
          "value": "/favicon.ico"
        },
        {
          "name": "SESSION_SECRET",
          "value": "template-session-secret-key-2024"
        },
        {
          "name": "NODE_ENV",
          "value": "production"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/template-edsteward",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
} 