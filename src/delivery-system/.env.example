# EdSteward Integration Configuration
# Copy this file to .env and update the values for your environment

# LOCAL TESTING (default values)
EDSTEWARD_URL=http://localhost:3000
EDSTEWARD_WS_URL=ws://localhost:3000/ws
EDSTEWARD_API_KEY=

# PRODUCTION EXAMPLES (uncomment and update for production)
# EDSTEWARD_URL=https://edsteward.university.edu:3000
# EDSTEWARD_WS_URL=wss://edsteward.university.edu:3000/ws
# EDSTEWARD_API_KEY=your-production-api-key

# CUSTOMER-SPECIFIC EXAMPLES
# Customer A - University
# EDSTEWARD_URL=https://compliance.university-a.edu
# EDSTEWARD_WS_URL=wss://compliance.university-a.edu/ws

# Customer B - Corporate
# EDSTEWARD_URL=http://192.168.1.100:3000
# EDSTEWARD_WS_URL=ws://192.168.1.100:3000/ws

# Customer C - Cloud Hosted
# EDSTEWARD_URL=https://customer-c.edsteward.cloud
# EDSTEWARD_WS_URL=wss://customer-c.edsteward.cloud/ws


