{
  "family": "edsteward-task-final",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::259661441422:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "edsteward-app",
      "image": "259661441422.dkr.ecr.us-east-1.amazonaws.com/edsteward:latest-amd64",
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "MULTI_TENANT",
          "value": "true"
        },
        {
          "name": "PORT",
          "value": "3000"
        },
        {
          "name": "DATABASE_URL",
          "value": "postgresql://neondb_owner:np-proj-YWJhMjY3NzctZjNjNy00OGU4LWJmZGYtOGYzYTIzOTkwMTMx@ep-weathered-term-a5rmi9cx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/edsteward-simple",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "essential": true
    }
  ]
} 