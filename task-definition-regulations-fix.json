{
  "family": "edsteward-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::259661441422:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::259661441422:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "edsteward-container",
      "image": "259661441422.dkr.ecr.us-east-1.amazonaws.com/edsteward-repo:latest",
      "portMappings": [
        {
          "containerPort": 5000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "5000"
        },
        {
          "name": "DATABASE_URL",
          "value": "postgresql://postgres:EdSteward2024!Secure@edsteward-public-db.cwv4g6g0yzmg.us-east-1.rds.amazonaws.com:5432/edsteward"
        },
        {
          "name": "DB_HOST",
          "value": "edsteward-public-db.cwv4g6g0yzmg.us-east-1.rds.amazonaws.com"
        },
        {
          "name": "DB_PORT",
          "value": "5432"
        },
        {
          "name": "DB_NAME",
          "value": "edsteward"
        },
        {
          "name": "DB_USER",
          "value": "postgres"
        },
        {
          "name": "DB_PASSWORD",
          "value": "EdSteward2024!Secure"
        },
        {
          "name": "SESSION_SECRET",
          "value": "edsteward-super-secret-session-key-2024"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/edsteward-task",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:5000/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
} 