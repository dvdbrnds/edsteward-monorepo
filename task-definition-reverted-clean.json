{
  "containerDefinitions": [
    {
      "name": "edsteward-app",
      "image": "259661441422.dkr.ecr.us-east-1.amazonaws.com/edsteward:aws-session-fix-1750593372",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "SESSION_SECRET",
          "value": "your-super-secret-session-key-change-in-production-2024"
        },
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "DOMAIN",
          "value": "edsteward.ai"
        },
        {
          "name": "DATABASE_URL",
          "value": "postgresql://neondb_owner:npg_foSr6ixkzw7W@ep-weathered-term-a5rmi9cx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
        },
        {
          "name": "PORT",
          "value": "3000"
        },
        {
          "name": "CORS_ORIGIN",
          "value": "https://admin.edsteward.ai,https://moravian.edsteward.ai"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/edsteward",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "debug"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:3000/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "systemControls": []
    }
  ],
  "family": "edsteward-task-fixed-health",
  "taskRoleArn": "arn:aws:iam::259661441422:role/ecsTaskRole",
  "executionRoleArn": "arn:aws:iam::259661441422:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "volumes": [],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "2048"
}
