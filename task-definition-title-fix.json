{
  "family": "edsteward-task-fixed-health",
  "taskRoleArn": "arn:aws:iam::259661441422:role/ecsTaskExecutionRole",
  "executionRoleArn": "arn:aws:iam::259661441422:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "containerDefinitions": [
    {
      "name": "edsteward-app",
      "image": "259661441422.dkr.ecr.us-east-1.amazonaws.com/edsteward:aws-session-fix-1750532569",
      "portMappings": [{"containerPort": 3000, "protocol": "tcp"}],
      "essential": true,
      "environment": [
        {"name": "NODE_ENV", "value": "production"},
        {"name": "DATABASE_URL", "value": "postgresql://neondb_owner:jQZx9rMgAFHJ@ep-weathered-term-a5rmi9cx.us-east-2.aws.neon.tech/neondb?sslmode=require"},
        {"name": "SESSION_SECRET", "value": "your-super-secret-session-key-change-this-in-production"},
        {"name": "VITE_API_URL", "value": "/api"}
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:3000/api/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/edsteward-task",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
} 